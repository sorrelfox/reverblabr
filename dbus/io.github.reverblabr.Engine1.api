#
# io.github.reverblabr.Engine1 as released (ADR-0020): every method and
# signal with its arguments, and every error code the Error signal and
# notice code the Notice signal carries, with the names in its argsJson. Lines are only ever added. A line that no
# longer matches is a breaking change, and belongs in Engine2.
# dbus.public-surface (tests/tools/test_dbus_public_surface.py) holds the
# XML, engine/core/errorcodes.h and docs/dbus-api.md to this file.

method ListSessions()
method CreateSession(in s name)
method OpenSession(in s sessionId)
method SaveSession(in s sessionId)
method CloseSession(in s sessionId)
method DeleteSession(in s sessionId)
method ExportSession(in s sessionId, in s path)
method ImportSession(in s path)
method ListPresets(in s typeId)
method ApplyPreset(in s sessionId, in s blockId, in s presetId)
method SavePreset(in s sessionId, in s blockId, in s name, in b replace)
method RenamePreset(in s typeId, in s presetId, in s name)
method DeletePreset(in s typeId, in s presetId)
method ApplyEdit(in s sessionId, in s editJson)
method SetParam(in s sessionId, in s blockId, in s paramId, in s valueJson)
method Undo(in s sessionId)
method Redo(in s sessionId)
method GetUndoState(in s sessionId)
method ControlRecording(in s sessionId, in s blockId, in s action)
method RestartPlugin(in s sessionId, in s blockId)
method Analyse(in s sessionId, in s blockId, in i channel)
method Start(in s sessionId)
method Stop(in s sessionId)
method GetSessionState(in s sessionId)
method Resynchronise(in s sessionId)
method GetInventory()
method GetBlockCatalogue()
method GetAudioSystem()
method ReconnectAudioSystem()
method ListVirtualDevices()
method CreateVirtualDevice(in s deviceJson)
method RenameVirtualDevice(in s deviceId, in s name)
method SetVirtualDeviceEnabled(in s deviceId, in b enabled)
method DeleteVirtualDevice(in s deviceId)
method ReloadVirtualDevices()
method ListRecordings(in s sessionId)
method RescanRecordings()
method GetRecording(in s path)
method RenameRecording(in s path, in s name)
method SetRecordingTags(in s path, in s tagsJson)
method PreviewRecording(in s path)
method PausePreview()
method SeekPreview(in d seconds)
method StopPreview()
method ListPlugins()
method RescanPlugins(in b retryBlocked)
method DescribePlugin(in s format, in s id)
signal SessionsListed(s sessionsJson)
signal SessionOpened(s sessionId)
signal SessionClosed(s sessionId)
signal SessionSnapshot(s sessionId, t revision, s sessionJson)
signal SessionPatch(s sessionId, t revision, s patchJson)
signal UndoStateChanged(s sessionId, b canUndo, s undoCode, b canRedo, s redoCode)
signal StateChanged(s sessionId, s state)
signal InventoryChanged(s inventoryJson)
signal BlockCatalogueChanged(s catalogueJson)
signal AudioSystemChanged(s audioSystemJson)
signal OpenUrlRequested(s sessionId, s url)
signal PresetsListed(s typeId, s presetsJson)
signal VirtualDevicesChanged(s devicesJson)
signal VirtualDeviceCreated(s deviceId)
signal RecordingFileStarted(s sessionId, s blockId, s path)
signal RecordingFileFinished(s sessionId, s blockId, s path, s detailsJson)
signal RecordingPaused(s sessionId, s blockId, b paused)
signal RecordingStopped(s sessionId, s blockId, s reason)
signal PluginsChanged(s pluginsJson)
signal PluginDescribed(s format, s id, s descriptionJson)
signal RecordingsChanged(s sessionId, s recordingsJson)
signal RecordingDetails(s path, s detailsJson)
signal RecordingRenamed(s oldPath, s newPath)
signal PreviewChanged(s previewJson)
signal Error(s code, s argsJson)
error block.unknownType(type)
error graph.cycle()
error routing.feedbackLoop(path)
error session.corruptFile(file, backup)
error session.notFound(session)
error session.notSaved(session, reason)
error session.cannotRun(session, reason)
error edit.refused(reason)
error preset.refused(preset, reason)
error device.virtualNotCreated(name, reason)
error device.virtualRefused(device, reason)
error device.virtualNodeRefused(device)
error recording.failed(file, reason)
error recording.overflow(file, seconds)
error recording.lowDiskSpace(file, megabytes)
error recording.refused(reason)
error recording.tagsNotWritten(file)
error plugin.crashed(plugin)
error plugin.stoppedResponding(plugin)
error plugin.restartRefused(reason)
error recording.previewFailed(file, reason)
error recording.notFound(file)
error recording.renameRefused(file, reason)
error recording.tagsNotSaved(file)
error session.overloaded(session)
signal Notice(s code, s argsJson)
notice device.lost(session, device)
notice device.returned(session, device)
notice capture.lost(session, application)
notice capture.regained(session, application)
method GetDiagnostics()
signal Diagnostics(s diagnosticsJson)
