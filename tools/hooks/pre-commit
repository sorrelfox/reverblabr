#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Reverblabr contributors
# SPDX-License-Identifier: MPL-2.0
#
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# Clean-room check: rejects the commit when a staged file name, or a line the
# commit adds, contains a term from .git/info/forbidden-terms. Without that
# file the check does nothing.
#
# Install for this clone: git config core.hooksPath tools/hooks

set -euo pipefail

source "$(dirname "$0")/forbidden-terms.sh"

terms=$(mktemp)
trap 'rm -f "$terms"' EXIT
rb_load_forbidden_terms "$terms" || exit 0

status=0

# File names of added, copied, modified and renamed files.
while IFS= read -r -d '' path; do
    lower=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
    while IFS= read -r term; do
        case "$lower" in
            *"$term"*)
                printf 'pre-commit: file name contains the forbidden term "%s": %s\n' "$term" "$path" >&2
                status=1
                ;;
        esac
    done < "$terms"
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Lines the commit adds, with their file and line number. The top-level
# README is left out: it names the program that inspired this one, the one
# place the project names another product on purpose.
git diff --cached --no-color --no-ext-diff -U0 --diff-filter=ACMR -- . ':(top,exclude)README.md' |
    awk -v terms_file="$terms" '
        BEGIN {
            while ((getline term < terms_file) > 0) {
                terms[++count] = term
            }
        }
        /^\+\+\+ / {
            file = substr($0, 5)
            sub(/^b\//, "", file)
            next
        }
        /^@@ / {
            match($0, /\+[0-9]+/)
            line = substr($0, RSTART + 1, RLENGTH - 1) - 1
            next
        }
        /^\+/ {
            line++
            text = tolower(substr($0, 2))
            for (i = 1; i <= count; i++) {
                if (index(text, terms[i]) > 0) {
                    printf "pre-commit: %s:%d contains the forbidden term \"%s\"\n", file, line, terms[i] > "/dev/stderr"
                    found = 1
                }
            }
        }
        END { exit found }
    ' || status=1

if [ "$status" -ne 0 ]; then
    printf 'pre-commit: commit rejected by the clean-room check (see CONTRIBUTING.md).\n' >&2
fi
exit "$status"
