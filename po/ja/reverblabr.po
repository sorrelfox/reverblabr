#: blocks/voicegauge/ui/VoiceGaugeWords.qml:194
msgctxt "@info a held reading and where it stands, 'Held · between marks'"
msgid "Held · %1"
msgstr "ホールド中 · %1"

#: blocks/voicegauge/ui/VoiceGaugeWords.qml:198
msgctxt "@info a Voice Gauge waiting for a first second of voice"
