#: ctl/commands.cpp:449
msgctxt "@info"
msgid "There are no timers."
msgstr "Nie ma żadnych timerów."

#: ctl/commands.cpp:475
msgctxt "@info"
msgid "The timer %1 started “%2”."
msgstr "Timer %1 uruchomił sesję „%2”."

#: ctl/commands.cpp:476
msgctxt "@info"
msgid "“%2” was running already, so the timer %1 left it as it is."
msgstr "Sesja „%2” już działała, więc timer %1 pozostawił ją bez zmian."

#: ctl/commands.cpp:493
msgctxt "@info"
msgid "There is no session called “%1”."
msgstr "Nie ma sesji o nazwie „%1”."

#: ctl/commands.cpp:496
msgctxt "@info"
msgid "More than one session is called “%1”. Name it by its id: %2"
msgstr ""
"Więcej niż jedna sesja nosi nazwę „%1”. Wskaż ją za pomocą identyfikatora: %2"

#: ctl/commands.cpp:501
msgctxt "@info"
msgid "The session has no block of the kind this needs (%1)."
msgstr "W sesji nie ma bloku wymaganego rodzaju (%1)."

#: ctl/commands.cpp:503
msgctxt "@info"
msgid "The session has no block called “%1”."
msgstr "W sesji nie ma bloku o nazwie „%1”."

#: ctl/commands.cpp:507
msgctxt "@info"
msgid "The session has more than one block of that kind. Name one: %1"
msgstr ""
"W sesji jest więcej niż jeden blok tego rodzaju. Wskaż jeden z nich: %1"

#: ctl/commands.cpp:510
msgctxt "@info"
msgid "More than one block is called “%1”. Name it by its id: %2"
msgstr ""
"Więcej niż jeden blok nosi nazwę „%1”. Wskaż go za pomocą identyfikatora: %2"

#: ctl/commands.cpp:514
msgctxt "@info"
msgid "“%1” has no setting called %2."
msgstr "Blok „%1” nie ma ustawienia o nazwie %2."

#: ctl/commands.cpp:518
msgctxt "@info"
msgid "%1 cannot be “%2”. It takes one of: %3"
msgstr ""
"Ustawienie %1 nie może mieć wartości „%2”. Przyjmuje jedną z wartości: %3"

#: ctl/commands.cpp:522
msgctxt "@info"
msgid "%1 cannot be “%2”. It takes a number from %3 to %4."
msgstr ""
"Ustawienie %1 nie może mieć wartości „%2”. Przyjmuje liczbę od %3 do %4."

#: ctl/commands.cpp:525
msgctxt "@info"
msgid "%1 cannot be “%2”."
msgstr "Ustawienie %1 nie może mieć wartości „%2”."

#: ctl/commands.cpp:528
msgctxt "@info"
msgid "%1 is something the block reports, and cannot be set."
msgstr "Parametr %1 jest odczytem bloku i nie można go ustawić."

#: ctl/commands.cpp:536
msgctxt "@info"
msgid "There is no session bus to reach the engine on."
msgstr "Brak magistrali sesji, przez którą można połączyć się z silnikiem."

#: ctl/commands.cpp:539
msgctxt "@info"
msgid "The engine is not running."
msgstr "Silnik nie działa."

#: ctl/commands.cpp:542
msgctxt "@info"
msgid "The engine would not start (%1)."
msgstr "Nie udało się uruchomić silnika (%1)."

#: ctl/commands.cpp:544
msgctxt "@info"
msgid "The engine is not installed, so the session bus cannot start it."
msgstr ""
"Silnik nie jest zainstalowany, więc magistrala sesji nie może go uruchomić."

#: ctl/commands.cpp:547
msgctxt "@info"
msgid "The engine did not answer %1 in time."
msgstr "Silnik nie odpowiedział na czas na wywołanie %1."

#: ctl/commands.cpp:553
msgctxt "@info"
msgid "The engine did not take the call: %1"
msgstr "Silnik nie przyjął wywołania: %1"

#: ctl/commands.cpp:556
msgctxt "@info"
msgid "“%1” could not start (%2)."
msgstr "Nie udało się uruchomić sesji „%1” (%2)."

#: ctl/commands.cpp:560
msgctxt "@info"
msgid "The engine refused the change (%1)."
msgstr "Silnik odrzucił zmianę (%1)."

#: ctl/commands.cpp:563
msgctxt "@info"
msgid "There is no timer “%1”."
msgstr "Nie ma timera „%1”."

#: ctl/commands.cpp:567
msgctxt "@info"
msgid ""
"The timer %1 came round more than two minutes after its time, perhaps after "
"the computer slept, so its session was not started."
msgstr ""
"Timer %1 zadziałał ponad dwie minuty po wyznaczonym czasie, być może po "
"uśpieniu komputera, więc jego sesja nie została uruchomiona."

#: ctl/commands.cpp:572
msgctxt "@info"
msgid "The recording could not be split (%1)."
msgstr "Nie udało się podzielić nagrania (%1)."

#: ctl/commands.cpp:576
msgctxt "@info engine error code and its details"
msgid "The engine refused: %1 %2"
msgstr "Silnik odmówił: %1 %2"

#: ctl/main.cpp:56
msgctxt "@info:usage"
msgid ""
"Usage: reverblabr-ctl [--json] [--timeout SECONDS] [--no-activate] COMMAND\n"
"\n"
"Commands:\n"
"  list                              the sessions' names, one a line\n"
"  status [SESSION]                  every session's state, or one's\n"
"  start SESSION                     run a session\n"
"  stop SESSION                      stop a session\n"
"  split SESSION [RECORDER]          start a new file in a running session's Recorders\n"
"  switch SESSION [SWITCH] A|B       turn an Input Switch to A or B\n"
"  set SESSION BLOCK SETTING VALUE   change one setting of a block\n"
"  timers list [SESSION]             every session's timers, or one's\n"
"  timer-fire [--scheduled] TIMER    do now what a timer does when its time comes\n"
"\n"
"A session is named by its name or its id, a block by its name or its id.\n"
"  --json            print the answer as JSON, the same in every language\n"
"  --timeout SECONDS how long to wait for the engine (10)\n"
"  --no-activate     only ask an engine that is already running\n"
msgstr ""
"Użycie: reverblabr-ctl [--json] [--timeout SEKUNDY] [--no-activate] POLECENIE\n"
"\n"
"Polecenia:\n"
"  list                                nazwy sesji, po jednej w wierszu\n"
"  status [SESJA]                      stan każdej sesji lub jednej z nich\n"
"  start SESJA                         uruchamia sesję\n"
"  stop SESJA                          zatrzymuje sesję\n"
"  split SESJA [REJESTRATOR]           zaczyna nowy plik w blokach Rejestrator działającej sesji\n"
"  switch SESJA [PRZEŁĄCZNIK] A|B      przełącza blok Przełącznik wejść na A lub B\n"
"  set SESJA BLOK USTAWIENIE WARTOŚĆ   zmienia jedno ustawienie bloku\n"
"  timers list [SESJA]                 timery każdej sesji lub jednej z nich\n"
"  timer-fire [--scheduled] TIMER      wykonuje teraz to, co timer robi, gdy nadejdzie jego czas\n"
"\n"
"Sesję i blok wskazuje się nazwą lub identyfikatorem.\n"
"  --json            wypisuje odpowiedź jako JSON, taki sam w każdym języku\n"
"  --timeout SEKUNDY jak długo czekać na silnik (10)\n"
"  --no-activate     pyta tylko silnik, który już działa\n"

#: ctl/main.cpp:117
msgctxt "@info"
msgid "--timeout takes a number of seconds, not “%1”."
msgstr "Opcja --timeout przyjmuje liczbę sekund, a nie „%1”."

