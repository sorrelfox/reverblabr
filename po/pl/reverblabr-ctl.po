#: ctl/commands.cpp:272
msgctxt "@info"
msgid "Stopped “%1”."
msgstr "Zatrzymano sesję „%1”."

#: ctl/commands.cpp:318
msgctxt "@info"
msgid "“%1” started a new file: %2"
msgstr "Blok „%1” rozpoczął nowy plik: %2"

#: ctl/commands.cpp:401
