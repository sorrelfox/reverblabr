#: app/appinfo.cpp:42
msgctxt "@info"
msgid "Application framework"
msgstr "应用程序框架"

#: app/appinfo.cpp:47
msgctxt "@info"
msgid "Desktop libraries"
msgstr "桌面程序库"

#: app/appinfo.cpp:51
msgctxt "@info"
msgid "Audio and video server"
msgstr "音视频服务器"

#: app/blockpresentation.cpp:62
msgctxt "@title:group blocks that bring sound in"
msgid "Sources"
msgstr "音源"

#: app/blockpresentation.cpp:63
msgctxt "@title:group blocks that send sound out"
msgid "Outputs"
msgstr "输出"

#: app/blockpresentation.cpp:64
msgctxt "@title:group blocks that change the sound"
msgid "Built-in Effects"
msgstr "内置效果"

#: app/blockpresentation.cpp:65
msgctxt "@title:group blocks that measure the sound"
msgid "Meters"
msgstr "仪表"

#: app/blockpresentation.cpp:66
msgctxt "@title:group blocks for less usual jobs"
msgid "Advanced"
msgstr "高级"

#: app/blockpresentation.cpp:69
msgctxt ""
"@title:group blocks that shape the sound for each ear on its own, for "
"listening"
msgid "Hearing"
msgstr "听力"

#: app/blockpresentation.cpp:70
msgctxt "@title:group blocks that host somebody else's plugin"
msgid "Plugins"
msgstr "插件"

#: app/blockpresentation.cpp:80
msgctxt "@item block name"
msgid "Application"
msgstr "应用程序"

#: app/blockpresentation.cpp:81
msgctxt "@info block description"
msgid "Sound from one application"
msgstr "来自单个应用程序的声音"

#: app/blockpresentation.cpp:83
msgctxt "@info:tooltip block description"
msgid ""
"Sound from one application, taken as it plays. The application goes on "
"playing to its own device, and the microphone it is using can be taken with "
"it."
msgstr "在单个应用程序播放时获取其声音。该应用程序照常向自己的设备播放，它正在使用的麦克风也可以一并获取。"

#: app/blockpresentation.cpp:87
msgctxt "@item block name"
msgid "Input Device"
msgstr "输入设备"

#: app/blockpresentation.cpp:88
msgctxt "@info block description"
msgid "A microphone or other recording input"
msgstr "麦克风或其他录音输入"

#: app/blockpresentation.cpp:90
msgctxt "@info:tooltip block description"
msgid ""
"A microphone, an audio interface or anything else this machine can record "
"from. Choose which of its channels feed the left and the right side."
msgstr "麦克风、音频接口或这台机器能录音的任何其他设备。可选择由它的哪些声道输送到左侧和右侧。"

#: app/blockpresentation.cpp:94
msgctxt "@item block name"
msgid "System Audio"
msgstr "系统音频"

#: app/blockpresentation.cpp:95
msgctxt "@info block description"
msgid "Everything this machine is playing"
msgstr "这台机器正在播放的所有声音"

#: app/blockpresentation.cpp:97
msgctxt "@info:tooltip block description"
msgid ""
"Everything this machine is playing, gathered one application at a time. Alert"
" sounds and any applications you name are left out."
msgstr "这台机器正在播放的所有声音，逐个应用程序收集。提示音和您指定的应用程序会被排除。"

#: app/blockpresentation.cpp:103
msgctxt "@item block name"
msgid "Broadcast"
msgstr "广播"

#: app/blockpresentation.cpp:104
msgctxt "@info block description"
msgid "A stream for an internet radio server"
msgstr "发往网络电台服务器的流"

#: app/blockpresentation.cpp:106
msgctxt "@info:tooltip block description"
msgid ""
"Sends the session to an internet radio server, with the station's details and"
" the title of whatever is playing."
msgstr "将会话发送到网络电台服务器，并附带电台信息和正在播放内容的标题。"

#: app/blockpresentation.cpp:110
msgctxt "@item block name"
msgid "Live Stream"
msgstr "直播"

#: app/blockpresentation.cpp:111
msgctxt "@info block description"
msgid "A video stream for a streaming platform"
msgstr "发往直播平台的视频流"

#: app/blockpresentation.cpp:113
msgctxt "@info:tooltip block description"
msgid ""
"Sends the session to a streaming platform as video, behind a picture made "
"here from a title, a logo and an optional moving display."
msgstr "将会话以视频形式发送到直播平台，画面由此处根据标题、徽标和可选的动态显示生成。"

#: app/blockpresentation.cpp:117
msgctxt "@item block name"
msgid "Wave"
msgstr "信号发生器"

#: app/blockpresentation.cpp:118
msgctxt "@info block description"
msgid "A test tone or noise, on either side or both"
msgstr "测试音或噪声，可在任一侧或两侧"

#: app/blockpresentation.cpp:120
msgctxt "@info:tooltip block description"
msgid ""
"Makes a sound of its own for testing speakers, cables and levels: a sine, "
"square, triangle or sawtooth at any frequency, or white or pink noise, at the"
" level you set, on the left, the right or both. It starts quiet. Send it to "
"an Output Device to hear it."
msgstr ""
"自行产生声音，用于测试扬声器、线缆和电平：任意频率的正弦波、方波、三角波或锯齿波，或者白噪声、粉红噪声，电平由您设定，可在左侧、右侧或两侧。它开始时音量很低。将它发送到输出设备即可听到。"

#: app/blockpresentation.cpp:125
msgctxt "@item block name"
msgid "Output Device"
msgstr "输出设备"

#: app/blockpresentation.cpp:126
msgctxt "@info block description"
msgid "Speakers, headphones or another output"
msgstr "扬声器、耳机或其他输出"

#: app/blockpresentation.cpp:128
msgctxt "@info:tooltip block description"
msgid ""
"The session's sound on speakers, headphones or anything else that plays, at "
"its own volume. It follows the system's choice until you name a device."
msgstr "以独立的音量，在扬声器、耳机或其他任何能播放的设备上播放会话的声音。在您指定设备之前，它跟随系统的选择。"

#: app/blockpresentation.cpp:132
msgctxt "@item block name"
msgid "Recorder"
msgstr "录音机"

#: app/blockpresentation.cpp:133
msgctxt "@info block description"
msgid "A recording of the session, written to a file"
msgstr "将会话录制并写入文件"

#: app/blockpresentation.cpp:135
msgctxt "@info:tooltip block description"
msgid ""
"Writes the session to a file in the format and quality you choose, named from"
" the date, the session and a counter."
msgstr "按您选择的格式和质量将会话写入文件，文件名由日期、会话和计数器组成。"

#: app/blockpresentation.cpp:139
msgctxt "@item block name"
msgid "Virtual Device"
msgstr "虚拟设备"

#: app/blockpresentation.cpp:140
msgctxt "@info block description"
msgid "The session as an input other apps can choose"
msgstr "将会话作为其他应用可选择的输入"

#: app/blockpresentation.cpp:142
msgctxt "@info:tooltip block description"
msgid ""
"Publishes the session as a recording device, so a meeting, a streaming tool "
"or a recorder can pick it as their microphone."
msgstr "将会话发布为录音设备，让会议软件、直播工具或录音软件可以把它选作麦克风。"

#: app/blockpresentation.cpp:148
msgctxt "@item block name"
msgid "10-Band EQ"
msgstr "10 段均衡器"

#: app/blockpresentation.cpp:149
msgctxt "@info block description"
msgid "Shapes the tone with ten fixed bands"
msgstr "用十个固定频段调整音色"

#: app/blockpresentation.cpp:151
msgctxt "@info:tooltip block description"
msgid ""
"Shapes the tone with ten sliders, from the lowest rumble to the highest air. "
"Presets cover the usual jobs, and one action puts every slider back."
msgstr "用十个滑块调整音色，从最低的隆隆声到最高的空气感。预设涵盖常见用途，一个操作即可将所有滑块复位。"

#: app/blockpresentation.cpp:155
msgctxt "@item block name"
msgid "Auto Level"
msgstr "自动电平"

#: app/blockpresentation.cpp:156
msgctxt "@info block description"
msgid "Evens out a source whose loudness keeps changing"
msgstr "使响度不断变化的音源变得平稳"

#: app/blockpresentation.cpp:158
msgctxt "@info:tooltip block description"
msgid ""
"Evens out a source whose loudness keeps changing: quiet passages are lifted "
"towards a steady level, and loud ones can be brought down to it."
msgstr "使响度不断变化的音源变得平稳：安静的段落会被提升到稳定的电平，响亮的段落也可以被压低到这一电平。"

#: app/blockpresentation.cpp:163
msgctxt "@item block name"
msgid "Night Level"
msgstr "夜间电平"

#: app/blockpresentation.cpp:164
msgctxt "@info block description"
msgid ""
"Keeps speech where it is and brings louder and quieter sounds towards it"
msgstr "保持语音不变，并让更响和更轻的声音向它靠拢"

#: app/blockpresentation.cpp:166
msgctxt "@info:tooltip block description"
msgid ""
"Finds the level of speech and moves other sounds towards it. Set apart how "
"far loud sounds come down and quiet sounds come up."
msgstr "找出语音的电平，并让其他声音向它靠拢。可分别设置响亮声音降低多少、安静声音提升多少。"

#: app/blockpresentation.cpp:170
msgctxt "@item block name"
msgid "Voice Forward"
msgstr "人声突出"

#: app/blockpresentation.cpp:171
msgctxt "@info block description"
msgid "Moves voices forward against music and effects"
msgstr "让人声在音乐和音效中更突出"

#: app/blockpresentation.cpp:173
msgctxt "@info:tooltip block description"
msgid ""
"Turns down what differs between left and right. A sound that is alike on both"
" sides stays where it is."
msgstr "调低左右两侧之间不同的部分。两侧相同的声音保持不变。"

#: app/blockpresentation.cpp:177
msgctxt "@item block name"
msgid "Balance"
msgstr "平衡"

#: app/blockpresentation.cpp:178
msgctxt "@info block description"
msgid "Trims one side of a stereo signal against the other"
msgstr "相对另一侧微调立体声信号的一侧"

#: app/blockpresentation.cpp:180
msgctxt "@info:tooltip block description"
msgid ""
"Trims one side of a stereo signal against the other and leaves the stereo "
"picture where it is. To move a sound across that picture instead, use Pan."
msgstr "相对另一侧微调立体声信号的一侧，同时保持立体声声场不变。如果要在声场中移动声音，请改用声像模块。"

#: app/blockpresentation.cpp:184
msgctxt "@item block name"
msgid "Bass & Treble"
msgstr "低音与高音"

#: app/blockpresentation.cpp:185
msgctxt "@info block description"
msgid "Lifts or cuts the low and the high end"
msgstr "提升或衰减低频和高频"

#: app/blockpresentation.cpp:187
msgctxt "@info:tooltip block description"
msgid ""
"Lifts or cuts the low and the high end, with one control for each. The "
"quickest way to warm up or brighten a source."
msgstr "提升或衰减低频和高频，各有一个控制项。这是让音源更温暖或更明亮的最快方法。"

#: app/blockpresentation.cpp:191
msgctxt "@item block name"
msgid "Channels"
msgstr "声道"

#: app/blockpresentation.cpp:192
msgctxt "@info block description"
msgid "Swaps, mutes or folds the left and right channels"
msgstr "交换、静音或合并左右声道"

#: app/blockpresentation.cpp:194
msgctxt "@info:tooltip block description"
msgid ""
"Swaps, mutes or folds the two channels — one side to both, a fold to mono, a "
"polarity flip — and fades from one arrangement to the next."
msgstr "交换、静音或合并两个声道——单侧送到两侧、合并为单声道、极性翻转——并在不同的安排之间平滑过渡。"

#: app/blockpresentation.cpp:198
msgctxt "@item block name"
msgid "Voice Compressor"
msgstr "人声压缩器"

#: app/blockpresentation.cpp:199
msgctxt "@info block description"
msgid "Holds a voice steady with three controls: compression, gate, ceiling"
msgstr "用三个控制项让人声保持平稳：压缩、噪声门、上限"

#: app/blockpresentation.cpp:201
msgctxt "@info:tooltip block description"
msgid ""
"Evens out a voice with one Compression control that makes up the level by "
"itself, a gentle gate for the quiet between words, and a limiter at the "
"ceiling you set."
msgstr "使人声平稳：一个能自动补偿电平的“压缩”控制项，一个处理字词间安静部分的柔和噪声门，以及一个位于您所设上限的限幅器。"

#: app/blockpresentation.cpp:205
msgctxt "@item block name"
msgid "Dynamics Processor"
msgstr "动态处理器"

#: app/blockpresentation.cpp:206
msgctxt "@info block description"
msgid "Holds loud sound back and lifts quiet sound"
msgstr "抑制响亮的声音，提升安静的声音"

#: app/blockpresentation.cpp:208
msgctxt "@info:tooltip block description"
msgid ""
"Holds back what is above the threshold and lifts or gates what is below it, "
"along a curve you can see and drag."
msgstr "沿着一条可见且可拖动的曲线，抑制高于阈值的部分，并提升或门控低于阈值的部分。"

#: app/blockpresentation.cpp:212
msgctxt "@item block name"
msgid "Echo"
msgstr "回声"

#: app/blockpresentation.cpp:213
msgctxt "@info block description"
msgid "Repeats the sound, each repeat quieter than the last"
msgstr "重复声音，每次重复都比上一次更轻"

#: app/blockpresentation.cpp:215
msgctxt "@info:tooltip block description"
msgid ""
"Repeats the sound after a delay you set, each repeat quieter and duller than "
"the one before, mixed in behind the original."
msgstr "在您设定的延时之后重复声音，每次重复都比前一次更轻、更暗，并混入原声之后。"

#: app/blockpresentation.cpp:219
msgctxt "@item block name"
msgid "High Pass Filter"
msgstr "高通滤波器"

#: app/blockpresentation.cpp:220
msgctxt "@info block description"
msgid "Rolls off everything below a chosen frequency"
msgstr "滚降所选频率以下的所有声音"

#: app/blockpresentation.cpp:222
msgctxt "@info:tooltip block description"
msgid ""
"Rolls off everything below a chosen frequency, for rumble, handling noise and"
" the thump of a room. The roll-off can be gentle or steep."
msgstr "滚降所选频率以下的所有声音，用于去除隆隆声、触碰噪声和房间的低频闷响。滚降可以平缓也可以陡峭。"

#: app/blockpresentation.cpp:226
msgctxt "@item block name"
msgid "Limiter"
msgstr "限幅器"

#: app/blockpresentation.cpp:227
msgctxt "@info block description"
msgid "Holds the signal below a ceiling it cannot cross"
msgstr "将信号保持在无法越过的上限以下"

#: app/blockpresentation.cpp:229
msgctxt "@info:tooltip block description"
msgid ""
"Holds the signal below a ceiling it cannot cross, listening ahead so nothing "
"slips through, and shows how much it is holding back."
msgstr "将信号保持在无法越过的上限以下，通过前瞻确保没有声音漏过，并显示它正在压低多少。"

#: app/blockpresentation.cpp:233
msgctxt "@item block name"
msgid "Low Pass Filter"
msgstr "低通滤波器"

#: app/blockpresentation.cpp:234
msgctxt "@info block description"
msgid "Rolls off everything above a chosen frequency"
msgstr "滚降所选频率以上的所有声音"

#: app/blockpresentation.cpp:236
msgctxt "@info:tooltip block description"
msgid ""
"Rolls off everything above a chosen frequency, for hiss and other high noise."
" The roll-off can be gentle or steep."
msgstr "滚降所选频率以上的所有声音，用于去除嘶嘶声和其他高频噪声。滚降可以平缓也可以陡峭。"

#: app/blockpresentation.cpp:240
msgctxt "@item block name"
msgid "Model"
msgstr "模型"

#: app/blockpresentation.cpp:241
msgctxt "@info block description"
msgid "Runs the sound through a trained model from a folder"
msgstr "让声音经过文件夹中的训练模型处理"

#: app/blockpresentation.cpp:243
msgctxt "@info:tooltip block description"
msgid ""
"Runs the sound through a trained model from a folder you choose. Only the "
"model's output leaves the block, so without one it is silent."
msgstr "让声音经过您所选文件夹中的训练模型处理。只有模型的输出会离开此模块，因此没有模型时它是静音的。"

#: app/blockpresentation.cpp:248
msgctxt "@item block name"
msgid "Mono Enhancer"
msgstr "单声道增强器"

#: app/blockpresentation.cpp:249
msgctxt "@info block description"
msgid "Widens a mono recording without breaking it"
msgstr "在不破坏单声道录音的前提下将其展宽"

#: app/blockpresentation.cpp:251
msgctxt "@info:tooltip block description"
msgid ""
"Gives a mono recording a sense of width, while the two sides still add back "
"up to the sound you started with."
msgstr "让单声道录音具有宽度感，同时两侧相加后仍能还原为最初的声音。"

#: app/blockpresentation.cpp:255
msgctxt "@item block name"
msgid "Multiband Compressor"
msgstr "多段压缩器"

#: app/blockpresentation.cpp:256
msgctxt "@info block description"
msgid "Steadies the low, middle and high ranges apart"
msgstr "分别稳定低、中、高频段"

#: app/blockpresentation.cpp:258
msgctxt "@info:tooltip block description"
msgid ""
"Steadies the low, the middle and the high range separately, so a loud voice "
"does not pull the bass down with it."
msgstr "分别稳定低频、中频和高频，这样响亮的人声就不会连带把低音压下去。"

#: app/blockpresentation.cpp:262
msgctxt "@item block name"
msgid "Pan"
msgstr "声像"

#: app/blockpresentation.cpp:263
msgctxt "@info block description"
msgid "Places a sound between the left and the right"
msgstr "将声音放在左右之间"

#: app/blockpresentation.cpp:265
msgctxt "@info:tooltip block description"
msgid ""
"Places a sound anywhere between the left and the right, at the same loudness "
"wherever it sits. To trim one side of a stereo pair instead, use Balance."
msgstr "将声音放在左右之间的任意位置，无论放在哪里响度都相同。如果要微调立体声的一侧，请改用平衡模块。"

#: app/blockpresentation.cpp:269
msgctxt "@item block name"
msgid "Pitch Shift"
msgstr "变调"

#: app/blockpresentation.cpp:270
msgctxt "@info block description"
msgid "Moves the pitch up or down, at the same speed"
msgstr "升高或降低音高，速度不变"

#: app/blockpresentation.cpp:272
msgctxt "@info:tooltip block description"
msgid ""
"Moves the pitch up or down by whole notes and fractions of one, without the "
"sound running faster or slower."
msgstr "以半音和音分为单位升高或降低音高，声音不会变快或变慢。"

#: app/blockpresentation.cpp:276
msgctxt "@item block name"
msgid "Reverb"
msgstr "混响"

#: app/blockpresentation.cpp:277
msgctxt "@info block description"
msgid "Puts the sound in a room, from a booth to a hall"
msgstr "把声音放进一个空间，从小隔间到大厅"

#: app/blockpresentation.cpp:279
msgctxt "@info:tooltip block description"
msgid ""
"Puts the sound in a room, from a small booth to a hall, with the size, the "
"brightness and how much of it is heard all under control."
msgstr "把声音放进一个空间，从小隔间到大厅，大小、亮度以及混响的多少都可以控制。"

#: app/blockpresentation.cpp:283
msgctxt "@item block name"
msgid "Simple Compressor"
msgstr "简易压缩器"

#: app/blockpresentation.cpp:284
msgctxt "@info block description"
msgid "Steadies the level from one choice, not six controls"
msgstr "只需一个选择即可稳定电平，无需调节六个控制项"

#: app/blockpresentation.cpp:286
msgctxt "@info:tooltip block description"
msgid ""
"Steadies the level by picking how firmly it should work, rather than setting "
"a threshold, a ratio and a pair of times yourself."
msgstr "只需选择作用的力度即可稳定电平，无需自己设置阈值、比率和两个时间参数。"

#: app/blockpresentation.cpp:290
msgctxt "@item block name"
msgid "Volume"
msgstr "音量"

#: app/blockpresentation.cpp:291
msgctxt "@info block description"
msgid "Turns a source up or down to match the others"
msgstr "调高或调低音源，使其与其他音源相匹配"

#: app/blockpresentation.cpp:293
msgctxt "@info:tooltip block description"
msgid ""
"Turns a source up or down, as a percentage of what arrived. A limiter sits at"
" the end of it, so turning a source up cannot make it clip."
msgstr "按输入的百分比调高或调低音源。末端有一个限幅器，因此调高音源不会导致削波。"

#: app/blockpresentation.cpp:297
msgctxt "@item block name"
msgid "Amplify"
msgstr "放大"

#: app/blockpresentation.cpp:298
msgctxt "@info block description"
msgid "Makes a source louder, up to ten times, and nothing else"
msgstr "只把音源放大，最多十倍，不做其他处理"

#: app/blockpresentation.cpp:300
msgctxt "@info:tooltip block description"
msgid ""
"Multiplies the sound by a gain from 0 to 1000 %. No limiter: a sound turned "
"up past full scale clips."
msgstr "将声音乘以 0 到 1000% 的增益。没有限幅器：调高到超过满刻度的声音会削波。"

#: app/blockpresentation.cpp:306
msgctxt "@item block name"
msgid "Peak/RMS"
msgstr "峰值/RMS"

#: app/blockpresentation.cpp:307
msgctxt "@info block description"
msgid "A level meter for any point in a lane"
msgstr "可放在轨道任意位置的电平表"

#: app/blockpresentation.cpp:309
msgctxt "@info:tooltip block description"
msgid ""
"Shows both the peaks and the average level at this point in the lane, and "
"passes the sound on exactly as it arrived."
msgstr "显示轨道此处的峰值和平均电平，并将声音原样传递下去。"

#: app/blockpresentation.cpp:313
msgctxt "@item block name"
msgid "VU"
msgstr "VU 表"

#: app/blockpresentation.cpp:314
msgctxt "@info block description"
msgid "A pair of needles following the average level"
msgstr "一对跟随平均电平的指针"

#: app/blockpresentation.cpp:316
msgctxt "@info:tooltip block description"
msgid ""
"A pair of needles that follow the average level the way a tape machine's "
"meters did, against a reference level you choose."
msgstr "一对指针像磁带机的电平表那样跟随平均电平，并以您选择的参考电平为基准。"

#: app/blockpresentation.cpp:320
msgctxt "@item block name"
msgid "Speech Now"
msgstr "说话指示"

#: app/blockpresentation.cpp:321
msgctxt "@info block description"
msgid "Shows a word and a dot while someone is speaking on this lane"
msgstr "当此轨道上有人说话时，显示一个词和一个圆点"

#: app/blockpresentation.cpp:323
msgctxt "@info:tooltip block description"
msgid ""
"Shows when a voice is on this lane and when it stops. The sound itself passes"
" unchanged."
msgstr "显示此轨道上何时出现人声、何时停止。声音本身原样通过。"

#: app/blockpresentation.cpp:326
msgctxt "@item block name"
msgid "Voice Gauge"
msgstr "人声电平表"

#: app/blockpresentation.cpp:327
msgctxt "@info block description"
msgid "Shows the level of a voice on this lane against marks you place"
msgstr "对照您设置的标记，显示此轨道上人声的电平"

#: app/blockpresentation.cpp:329
msgctxt "@info:tooltip block description"
msgid ""
"Reads the level of a voice on this lane over a few seconds and holds it "
"through pauses. The sound itself passes unchanged."
msgstr "在几秒钟内测量此轨道上人声的电平，并在停顿期间保持读数。声音本身原样通过。"

#: app/blockpresentation.cpp:333
msgctxt "@item block name"
msgid "Waveform"
msgstr "波形"

#: app/blockpresentation.cpp:334
msgctxt "@info block description"
msgid "Draws the sound at this point in a lane as it goes by"
msgstr "在声音经过时绘制轨道此处的声音"

#: app/blockpresentation.cpp:336
msgctxt "@info:tooltip block description"
msgid ""
"An oscilloscope for any point in a lane: choose how much time it shows, how "
"it is drawn and how it moves. The sound passes unchanged."
msgstr "可放在轨道任意位置的示波器：可选择显示多长时间、如何绘制以及如何移动。声音原样通过。"

#: app/blockpresentation.cpp:340
msgctxt "@item block name"
msgid "Spectrum"
msgstr "频谱"

#: app/blockpresentation.cpp:341
msgctxt "@info block description"
msgid "Shows how much of each frequency there is at this point in a lane"
msgstr "显示轨道此处各个频率的含量"

#: app/blockpresentation.cpp:343
msgctxt "@info:tooltip block description"
msgid ""
"A spectrum analyzer for any point in a lane, in bars: choose how many, how "
"fine and how they move. The sound passes unchanged."
msgstr "可放在轨道任意位置的柱状频谱分析仪：可选择柱条数量、精细程度和移动方式。声音原样通过。"

#: app/blockpresentation.cpp:347
msgctxt "@item block name"
msgid "Sound Side"
msgstr "声音偏向"

#: app/blockpresentation.cpp:348
msgctxt "@info block description"
msgid "Shows which side of the mix is louder right now"
msgstr "显示混音中此刻哪一侧更响"

#: app/blockpresentation.cpp:350
msgctxt "@info:tooltip block description"
msgid ""
"Compares the left and right channels of this lane and shows the louder side. "
"The sound passes unchanged."
msgstr "比较此轨道的左右声道，并显示更响的一侧。声音原样通过。"

#: app/blockpresentation.cpp:356
msgctxt "@item block name"
msgid "Declick"
msgstr "去咔嗒声"

#: app/blockpresentation.cpp:357
msgctxt "@info block description"
msgid "Takes out clicks, pops and crackle"
msgstr "去除咔嗒声、爆音和噼啪声"

#: app/blockpresentation.cpp:359
msgctxt "@info:tooltip block description"
msgid ""
"Takes out clicks, pops and crackle — from a record, a bad cable or a dropout "
"— and fills in what was underneath them."
msgstr "去除咔嗒声、爆音和噼啪声——无论来自唱片、劣质线缆还是信号中断——并补上它们掩盖的内容。"

#: app/blockpresentation.cpp:363
msgctxt "@item block name"
msgid "Dehum"
msgstr "去嗡嗡声"

#: app/blockpresentation.cpp:364
msgctxt "@info block description"
msgid "Takes out the steady hum of the mains supply"
msgstr "去除市电带来的持续嗡嗡声"

#: app/blockpresentation.cpp:366
msgctxt "@info:tooltip block description"
msgid ""
"Takes out the steady hum a mains supply leaves behind, at 50 or 60 Hz, "
"together with the whine that rides above it."
msgstr "去除市电留下的 50 或 60 Hz 持续嗡嗡声，以及叠加在其上的尖啸声。"

#: app/blockpresentation.cpp:370
msgctxt "@item block name"
msgid "Denoise"
msgstr "降噪"

#: app/blockpresentation.cpp:371
msgctxt "@info block description"
msgid "Takes out a steady noise once it has been learned"
msgstr "学习稳定的噪声后将其去除"

#: app/blockpresentation.cpp:373
msgctxt "@info:tooltip block description"
msgid ""
"Listens to a few seconds of the noise on its own, then takes that noise out "
"of everything that follows. For fans, hiss and air conditioning."
msgstr "先单独聆听几秒钟的噪声，然后从之后的所有声音中去除该噪声。适用于风扇声、嘶嘶声和空调声。"

#: app/blockpresentation.cpp:377
msgctxt "@item block name"
msgid "Ducking"
msgstr "闪避"

#: app/blockpresentation.cpp:378
msgctxt "@info block description"
msgid "Turns a background source down under a voice"
msgstr "有人声时调低背景音源"

#: app/blockpresentation.cpp:380
msgctxt "@info:tooltip block description"
msgid ""
"Turns the background source down whenever the main one — a voice, usually — "
"is heard, and brings it back up when the talking stops."
msgstr "每当听到主信号（通常是人声）时调低背景音源，说话停止后再将其恢复。"

#: app/blockpresentation.cpp:384
msgctxt "@item block name"
msgid "FIR Filter"
msgstr "FIR 滤波器"

#: app/blockpresentation.cpp:385
msgctxt "@info block description"
msgid "Applies a correction measured from a file"
msgstr "应用从文件中读取的测量校正"

#: app/blockpresentation.cpp:387
msgctxt "@info:tooltip block description"
msgid ""
"Applies a measurement taken from a file: the sound of a room, of a speaker "
"cabinet, or a correction for a particular pair of headphones."
msgstr "应用从文件中读取的测量结果：房间的声音、音箱的声音，或针对某副耳机的校正。"

#: app/blockpresentation.cpp:391
msgctxt "@item block name"
msgid "Input Switch"
msgstr "输入切换"

#: app/blockpresentation.cpp:392
msgctxt "@info block description"
msgid "Passes one of two inputs and fades between them"
msgstr "在两个输入中选择一个通过，并在两者之间淡入淡出"

#: app/blockpresentation.cpp:394
msgctxt "@info:tooltip block description"
msgid ""
"Passes one of two inputs and fades from one to the other when you switch, so "
"the change is never heard as a jump."
msgstr "在两个输入中选择一个通过，切换时从一个平滑过渡到另一个，因此不会听到突兀的跳变。"

#: app/blockpresentation.cpp:398
msgctxt "@item block name"
msgid "Mixer"
msgstr "混音器"

#: app/blockpresentation.cpp:399
msgctxt "@info block description"
msgid "Combines up to five sources, each with its own strip"
msgstr "合并最多五个音源，每个都有自己的通道条"

#: app/blockpresentation.cpp:401
msgctxt "@info:tooltip block description"
msgid ""
"Combines up to five sources, each with a fader, a mute, a solo and a balance,"
" and can bring a whole set of levels back at once."
msgstr "合并最多五个音源，每个都有推子、静音、独奏和平衡，并可一次性恢复整组电平。"

#: app/blockpresentation.cpp:405
msgctxt "@item block name"
msgid "Parametric EQ"
msgstr "参量均衡器"

#: app/blockpresentation.cpp:406
msgctxt "@info block description"
msgid "Shapes the tone with bands you place yourself"
msgstr "用您自己放置的频段调整音色"

#: app/blockpresentation.cpp:408
msgctxt "@info:tooltip block description"
msgid ""
"Shapes the tone with up to ten bands you place yourself — bells, shelves, "
"pass filters and notches — dragged along a curve with the sound that is "
"playing drawn behind it."
msgstr "用最多十个您自己放置的频段调整音色——钟形、搁架、高通与低通等滤波器以及陷波——在曲线上拖动即可，曲线后方会绘制正在播放的声音。"

#: app/blockpresentation.cpp:412
msgctxt "@item block name"
msgid "Speech Denoise"
msgstr "语音降噪"

#: app/blockpresentation.cpp:413
msgctxt "@info block description"
msgid "Clears noise from speech with nothing to set up"
msgstr "无需任何设置即可清除语音中的噪声"

#: app/blockpresentation.cpp:415
msgctxt "@info:tooltip block description"
msgid ""
"Clears the background from speech without learning it first, which suits a "
"voice in a room where the noise keeps changing."
msgstr "无需事先学习即可清除语音中的背景声，适合噪声不断变化的房间中的人声。"

#: app/blockpresentation.cpp:419
msgctxt "@item block name"
msgid "Sync"
msgstr "同步"

#: app/blockpresentation.cpp:420
msgctxt "@info block description"
msgid "Delays a lane to line it up with another"
msgstr "延迟一条轨道，使其与另一条对齐"

#: app/blockpresentation.cpp:422
msgctxt "@info:tooltip block description"
msgid ""
"Delays a lane by an exact number of milliseconds, to line the sound up with a"
" picture or with another path through the session."
msgstr "将轨道精确延迟若干毫秒，使声音与画面或会话中的另一条路径对齐。"

#: app/blockpresentation.cpp:426
msgctxt "@item block name"
msgid "Time Shift"
msgstr "时移"

#: app/blockpresentation.cpp:427
msgctxt "@info block description"
msgid "Pauses and rewinds sound that is still arriving"
msgstr "暂停和倒回仍在传入的声音"

#: app/blockpresentation.cpp:429
msgctxt "@info:tooltip block description"
msgid ""
"Holds on to the sound as it arrives, so it can be paused, wound back and "
"searched through, and then caught up with again."
msgstr "在声音传入时将其保存下来，因此可以暂停、倒回和查找，之后再追上实时。"

#: app/blockpresentation.cpp:433
msgctxt "@item block name"
msgid "Transcribe"
msgstr "转写"

#: app/blockpresentation.cpp:434
msgctxt "@info block description"
msgid "Writes down what is said, on this machine alone"
msgstr "记录所说的话，全程只在本机进行"

#: app/blockpresentation.cpp:436
msgctxt "@info:tooltip block description"
msgid ""
"Writes speech to a text file as it is spoken, with times and a label for each"
" speaker. The sound never leaves this machine."
msgstr "在说话的同时将语音写入文本文件，并附带时间和每位说话人的标签。声音绝不会离开本机。"

#: app/blockpresentation.cpp:443
msgctxt ""
"@item block name: a working name, gain for one ear by frequency and level"
msgid "Hearing Compensation 16"
msgstr "听力补偿 16"

#: app/blockpresentation.cpp:444
msgctxt "@info block description"
msgid "Lifts quiet sound for one ear, in sixteen bands"
msgstr "为单耳提升安静的声音，分十六个频段"

#: app/blockpresentation.cpp:446
msgctxt "@info:tooltip block description"
msgid ""
"Gives one ear more of what it hears faintly: in each of sixteen bands, soft "
"sound is lifted a lot and loud sound little, and nothing goes above a "
"ceiling. Its settings can be worked out from an audiogram."
msgstr ""
"为一只耳朵加强它听得模糊的声音：在十六个频段中的每一个里，轻柔的声音大幅提升，响亮的声音略微提升，且任何声音都不会超过上限。其设置可以根据听力图计算得出。"

#: app/blockpresentation.cpp:452
msgctxt ""
"@item block name: a working name, gain for one ear by frequency and level, "
"finely"
msgid "Hearing Compensation 64"
msgstr "听力补偿 64"

#: app/blockpresentation.cpp:453
msgctxt "@info block description"
msgid "Lifts quiet sound for one ear, in sixty-four bands set with points"
msgstr "为单耳提升安静的声音，分六十四个频段，用控制点设置"

#: app/blockpresentation.cpp:455
msgctxt "@info:tooltip block description"
msgid ""
"Gives one ear more of what it hears faintly, finely enough for a steep slope "
"or a narrow dip: place points along the curves and the sixty-four bands "
"follow them. Soft sound is lifted a lot and loud sound little, and nothing "
"goes above a ceiling. Its points can be worked out from an audiogram."
msgstr ""
"为一只耳朵加强它听得模糊的声音，精细到足以应对听力中陡峭的下降或狭窄的凹陷：沿曲线放置控制点，六十四个频段便会随之调整。轻柔的声音大幅提升，响亮的声音略微提升，且任何声音都不会超过上限。其控制点可以根据听力图计算得出。"

#: app/blockpresentation.cpp:461
msgctxt "@item block name"
msgid "Frequency Lowering"
msgstr "频率下移"

#: app/blockpresentation.cpp:462
msgctxt "@info block description"
msgid "Moves high sounds down to where one ear hears them"
msgstr "将高音下移到一只耳朵能听到的范围"

#: app/blockpresentation.cpp:464
msgctxt "@info:tooltip block description"
msgid ""
"Moves sound from a high range one ear makes no use of into a lower range it "
"hears, so that the hiss of s, sh and f is heard again. Up to four moves, each"
" squeezing its range down or copying it lower, for one ear; add another for "
"the other ear."
msgstr ""
"将一只耳朵用不上的高频范围内的声音移到它能听到的较低范围，让 s、sh 和 f "
"的嘶嘶声重新被听到。最多四个移频，每个都可将其范围向下挤压或复制到更低处，作用于一只耳朵；另一只耳朵请再添加一个。"

#: app/blockpresentation.cpp:469
msgctxt "@item block name"
msgid "Frequency Raising"
msgstr "频率上移"

#: app/blockpresentation.cpp:470
msgctxt "@info block description"
msgid "Moves low sounds up to where one ear hears them"
msgstr "将低音上移到一只耳朵能听到的范围"

#: app/blockpresentation.cpp:472
msgctxt "@info:tooltip block description"
msgid ""
"Moves sound from a low or middle range one ear makes no use of into a higher "
"range it hears. Up to four moves, each copying its range up, squeezing it, or"
" adding its harmonics higher up, for one ear; add another for the other ear. "
"With Frequency Lowering, it takes a dip in the middle apart: its lower half "
"down, its upper half up."
msgstr ""
"将一只耳朵用不上的低频或中频范围内的声音移到它能听到的较高范围。最多四个移频，每个都可将其范围向上复制、挤压，或在更高处添加其谐波，作用于一只耳朵；另一只耳朵请再添加一个。与频率下移配合使用，可将中间的凹陷拆开处理：下半部分下移，上半部分上移。"

#: app/blockpresentation.cpp:478
msgctxt "@item block name: joins a left and a right lane into one stereo pair"
msgid "Join L/R"
msgstr "左右合并"

#: app/blockpresentation.cpp:479
msgctxt "@info block description"
msgid "Puts a left and a right lane back into one stereo pair"
msgstr "将左、右两条轨道重新合并为一对立体声"

#: app/blockpresentation.cpp:481
msgctxt "@info:tooltip block description"
msgid ""
"Takes the left side from its Left input and the right side from its Right "
"input, so that each ear can have blocks of its own on a lane of its own. The "
"two are lined up however late either lane is."
msgstr "从“左”输入获取左侧，从“右”输入获取右侧，这样每只耳朵都可以在自己的轨道上拥有自己的模块。无论哪条轨道延迟多少，两者都会对齐。"

#: app/blockpresentation.cpp:486
msgctxt "@item block name: a mix of both sides for one ear"
msgid "One Ear Mix"
msgstr "单耳混音"

#: app/blockpresentation.cpp:487
msgctxt "@info block description"
msgid "A mono mix that puts both sides into one ear"
msgstr "将两侧放入一只耳朵的单声道混音"

#: app/blockpresentation.cpp:489
msgctxt "@info:tooltip block description"
msgid ""
"Puts both sides into one ear, or one mix on both sides for one earbud. Sound "
"panned to one side stays, and sound out of phase between the sides doesn't "
"cancel the way it does in a plain mono mix."
msgstr ""
"将两侧放入一只耳朵，或在两侧输出同一个混音，供只戴一只耳塞时使用。偏向一侧的声音会被保留，两侧相位相反的声音也不会像普通单声道混音那样相互抵消。"

#: app/blockpresentation.cpp:494
msgctxt "@item block name"
msgid "Sudden Sounds"
msgstr "突发声音"

#: app/blockpresentation.cpp:495
msgctxt "@info block description"
msgid "Softens sudden sharp sounds such as clicks and knocks"
msgstr "减弱咔嗒声、敲击声等突然的尖锐声音"

#: app/blockpresentation.cpp:497
msgctxt "@info:tooltip block description"
msgid ""
"Softens sudden sharp sounds such as clicks and knocks. Changes nothing until "
"you choose a Strength."
msgstr "减弱咔嗒声、敲击声等突然的尖锐声音。在您选择“强度”之前不做任何改变。"

#: app/blockpresentation.cpp:503
msgctxt "@item block name"
msgid "Test Plugin"
msgstr "测试插件"

#: app/blockpresentation.cpp:504
msgctxt "@info block description"
msgid "A plugin built in, for checking that plugins run"
msgstr "内置插件，用于检查插件能否运行"

#: app/blockpresentation.cpp:506
msgctxt "@info:tooltip block description"
msgid ""
"A plain gain that runs the way every plugin does: in a process of its own "
"beside Reverblabr, so that a plugin that fails takes nothing else with it. "
"For checking that plugins run on this machine."
msgstr ""
"一个简单的增益，以所有插件都采用的方式运行：在 Reverblabr "
"旁的独立进程中运行，因此出错的插件不会连带影响其他任何部分。用于检查插件能否在本机上运行。"

#: app/blockpresentation.cpp:511
msgctxt "@item block name"
msgid "CLAP"
msgstr "CLAP"

#: app/blockpresentation.cpp:512
msgctxt "@info block description"
msgid "A CLAP plugin installed on this machine"
msgstr "本机上安装的 CLAP 插件"

#: app/blockpresentation.cpp:514
msgctxt "@info:tooltip block description"
msgid ""
"A CLAP plugin installed on this machine. It runs beside Reverblabr rather "
"than inside it, so a plugin that fails takes nothing else with it."
msgstr "本机上安装的 CLAP 插件。它在 Reverblabr 旁运行，而不是在其内部运行，因此出错的插件不会连带影响其他任何部分。"

#: app/blockpresentation.cpp:518
msgctxt "@item block name"
msgid "LADSPA"
msgstr "LADSPA"

#: app/blockpresentation.cpp:519
msgctxt "@info block description"
msgid "A LADSPA plugin installed on this machine"
msgstr "本机上安装的 LADSPA 插件"

#: app/blockpresentation.cpp:521
msgctxt "@info:tooltip block description"
msgid ""
"A LADSPA plugin installed on this machine. These have no window of their own,"
" so their settings appear in a panel built from what they offer."
msgstr "本机上安装的 LADSPA 插件。这类插件没有自己的窗口，因此其设置会显示在根据插件所提供内容生成的面板中。"

#: app/blockpresentation.cpp:525
msgctxt "@item block name"
msgid "LV2"
msgstr "LV2"

#: app/blockpresentation.cpp:526
msgctxt "@info block description"
msgid "An LV2 plugin installed on this machine"
msgstr "本机上安装的 LV2 插件"

#: app/blockpresentation.cpp:528
msgctxt "@info:tooltip block description"
msgid ""
"An LV2 plugin installed on this machine, with its own window where it has one"
" and a panel built from its settings where it has not."
msgstr "本机上安装的 LV2 插件。有自带窗口时使用其窗口，没有时则使用根据其设置生成的面板。"

#: app/blockpresentation.cpp:532
msgctxt "@item block name"
msgid "VST3"
msgstr "VST3"

#: app/blockpresentation.cpp:533
msgctxt "@info block description"
msgid "A VST3 plugin installed on this machine"
msgstr "本机上安装的 VST3 插件"

#: app/blockpresentation.cpp:535
msgctxt "@info:tooltip block description"
msgid ""
"A VST3 plugin installed on this machine, with its own editor window and a "
"panel of the same settings beside it."
msgstr "本机上安装的 VST3 插件，带有自己的编辑器窗口，旁边还有一个包含相同设置的面板。"

#: app/blockpresentation.cpp:551
msgctxt "@item block name"
msgid "Voice Evener"
msgstr "人声调平"

#: app/blockpresentation.cpp:552
msgctxt "@info block description"
msgid "Keeps voices even: quiet talkers come up and loud ones come down"
msgstr "让人声保持均匀：说话轻的人声音提升，说话响的人声音降低"

#: app/blockpresentation.cpp:554
msgctxt "@info:tooltip block description"
msgid ""
"An Auto Level set up for voices on a call: a quiet talker comes up and a loud"
" one comes down towards one level, and what is near it is left alone."
msgstr "专为通话中的人声设置的自动电平：说话轻的人提升、说话响的人降低，都向同一个电平靠拢，而已接近该电平的声音保持不变。"

#: app/blockpresentation.cpp:627
msgctxt ""
"@label an input of the Ducking block: the voice that turns the other down"
msgid "Main"
msgstr "主信号"

#: app/blockpresentation.cpp:630
msgctxt "@label an input of the Ducking block: the sound that is turned down"
msgid "Background"
msgstr "背景"

#: app/blockpresentation.cpp:634 blocks/joinlr/ui/JoinLrHelp.qml:43
msgctxt ""
"@label an input of the Join L/R block: the lane the left ear comes in on"
msgid "Left"
msgstr "左"

#: app/blockpresentation.cpp:637 blocks/joinlr/ui/JoinLrHelp.qml:51
msgctxt ""
"@label an input of the Join L/R block: the lane the right ear comes in on"
msgid "Right"
msgstr "右"

#: app/blockpresentation.cpp:641
#: blocks/inputswitch/ui/InputSwitchControl.qml:40
msgctxt "@label the first input of the Input Switch block"
msgid "Input A"
msgstr "输入 A"

#: app/blockpresentation.cpp:644
#: blocks/inputswitch/ui/InputSwitchControl.qml:41
msgctxt "@label the second input of the Input Switch block"
msgid "Input B"
msgstr "输入 B"

#: app/blockpresentation.cpp:651
msgctxt "@label one of the Mixer block's numbered inputs"
msgid "Input %1"
msgstr "输入 %1"

#: app/blockpresentation.cpp:697
msgctxt "@info a block that is not finished yet"
msgid ""
"Beta: this block is still being debugged and may contain bugs. It is not yet "
"fully tested."
msgstr "测试版：此模块仍在调试中，可能存在缺陷，尚未经过全面测试。"

#: app/errormessages.cpp:34
msgctxt "@info"
msgid ""
"This session contains a block of type “%1”, which this version of Reverblabr "
"doesn't know. The block is kept, but it can't run."
msgstr "此会话包含一个类型为“%1”的模块，当前版本的 Reverblabr 无法识别它。该模块会被保留，但无法运行。"

#: app/errormessages.cpp:38
msgctxt "@info"
msgid ""
"The connections in this session form a loop. Remove one of the connections in"
" the loop to run the session."
msgstr "此会话中的连接构成了一个回路。请移除回路中的一个连接，才能运行此会话。"

#: app/errormessages.cpp:42
msgctxt "@info"
msgid ""
"This connection would feed the session's output back into its own input, so "
"it wasn't made. The sound would have gone round: %1."
msgstr "此连接会把会话的输出反馈回它自己的输入，因此未建立。声音将会循环经过：%1。"

#: app/errormessages.cpp:45
msgctxt "@info"
msgid ""
"The session file %1 is damaged and couldn't be opened. It was moved aside as "
"%2."
msgstr "会话文件 %1 已损坏，无法打开。它已被移到一旁，改名为 %2。"

#: app/errormessages.cpp:51
msgctxt ""
"@info %1 is a session's name, or its id or file when there is no name to give"
msgid ""
"Reverblabr couldn't find the session “%1”. Its file may have been moved or "
"deleted."
msgstr "Reverblabr 找不到会话“%1”。其文件可能已被移动或删除。"

#: app/errormessages.cpp:53
msgctxt "@info"
msgid ""
"The session %1 couldn't be saved: %2. It's still open, so nothing is lost."
msgstr "无法保存会话 %1：%2。它仍处于打开状态，因此没有丢失任何内容。"

#: app/errormessages.cpp:54
msgctxt "@info"
msgid "The session %1 couldn't be started: %2."
msgstr "无法启动会话 %1：%2。"

#: app/errormessages.cpp:55
msgctxt "@info"
msgid "That change wasn't made: %1. The session is as it was."
msgstr "未进行该更改：%1。会话保持原样。"

#: app/errormessages.cpp:56
msgctxt "@info"
msgid "The preset “%1” wasn't changed: %2."
msgstr "未更改预设“%1”：%2。"

#: app/errormessages.cpp:59
msgctxt "@info %1 is the name a virtual audio device was to have"
msgid "The virtual device “%1” wasn't made: %2."
msgstr "未创建虚拟设备“%1”：%2。"

#: app/errormessages.cpp:62
msgctxt "@info %1 is a virtual audio device's name"
msgid "The virtual device “%1” wasn't changed: %2. It's as it was."
msgstr "未更改虚拟设备“%1”：%2。它保持原样。"

#: app/errormessages.cpp:65
msgctxt "@info %1 is a virtual audio device's name"
msgid ""
"The audio system didn't make the virtual device “%1”. It's kept, and is tried"
" again the next time the audio system starts or the virtual devices change."
msgstr "音频系统未创建虚拟设备“%1”。它会被保留，并在音频系统下次启动或虚拟设备发生变化时重试。"

#: app/errormessages.cpp:69
msgctxt "@info %1 is a recording's file, with its folder"
msgid ""
"Recording to %1 stopped: %2. Anything already written to it is kept. Start "
"the session again to record again."
msgstr "录制到 %1 的录音已停止：%2。已写入的内容会被保留。请重新启动会话以再次录音。"

#: app/errormessages.cpp:73
msgctxt ""
"@info %1 is a recording's file, with its folder; %2 is a number of seconds"
msgid ""
"The disk didn't keep up, so %2 seconds are missing from the recording %1. "
"It's still recording."
msgstr "磁盘写入跟不上，因此录音 %1 中缺失了 %2 秒。录音仍在继续。"

#: app/errormessages.cpp:75
msgctxt "@info"
msgid "The recording wasn't paused, resumed or split: %1."
msgstr "未能暂停、继续或分割录音：%1。"

#: app/errormessages.cpp:78
msgctxt "@info %1 is a recording's file, with its folder"
msgid ""
"The recording %1 is complete, but its tags couldn't be written: it has no "
"title, artist or the rest."
msgstr "录音 %1 已完成，但无法写入其标签：它没有标题、艺术家等信息。"

#: app/errormessages.cpp:82
msgctxt "@info %1 is the plugin's name"
msgid ""
"Plugin crashed: %1 stopped, and the sound now goes around it. Restart it from"
" its panel."
msgstr "插件已崩溃：%1 已停止，声音现在会绕过它。请从其面板中重新启动它。"

#: app/errormessages.cpp:85
msgctxt "@info %1 is the plugin's name"
msgid ""
"Plugin stopped responding: %1 was closed, and the sound now goes around it. "
"Restart it from its panel."
msgstr "插件无响应：%1 已被关闭，声音现在会绕过它。请从其面板中重新启动它。"

#: app/errormessages.cpp:87
msgctxt "@info"
msgid "The plugin wasn't restarted: %1."
msgstr "未重新启动插件：%1。"

#: app/errormessages.cpp:89
msgctxt "@info %1 is a plugin preset's name; %2 is why"
msgid "The plugin preset %1 wasn't used: %2."
msgstr "未使用插件预设 %1：%2。"

#: app/errormessages.cpp:92
msgctxt "@info %1 is a recording's file, with its folder; %2 is why"
msgid "The recording %1 can't be played: %2."
msgstr "无法播放录音 %1：%2。"

#: app/errormessages.cpp:95
msgctxt "@info %1 is a recording's file, with its folder"
msgid ""
"The recording %1 isn't in the list of recordings any more: it was deleted or "
"moved."
msgstr "录音 %1 已不在录音列表中：它已被删除或移动。"

#: app/errormessages.cpp:98
msgctxt "@info %1 is a recording's file, with its folder; %2 is why"
msgid "The recording %1 wasn't renamed: %2. It's as it was."
msgstr "未重命名录音 %1：%2。它保持原样。"

#: app/errormessages.cpp:101
msgctxt "@info %1 is a session's name"
msgid ""
"The session %1 needed more time than each audio cycle allows, so it went "
"silent to keep Reverblabr running. Take out or switch off its heaviest "
"blocks, or raise the quantum, and it plays again."
msgstr ""
"会话 %1 所需的时间超出了每个音频周期允许的时长，因此已静音，以保证 Reverblabr 继续运行。移除或关闭其中最耗资源的模块，或调大 "
"quantum，即可恢复播放。"

#: app/errormessages.cpp:106
msgctxt "@info %1 is why"
msgid ""
"Reverblabr's background engine couldn't be started: %1. The engine runs in "
"this window instead, so its sessions stop when the window closes."
msgstr "无法启动 Reverblabr 的后台引擎：%1。引擎改为在此窗口中运行，因此关闭窗口时其会话会停止。"

#: app/errormessages.cpp:110
msgctxt "@info %1 is a timer's identifier"
msgid ""
"There's no timer %1 any more: it was deleted, or its session was. Nothing was"
" started."
msgstr "定时器 %1 已不存在：它或它的会话已被删除。未启动任何内容。"

#: app/errormessages.cpp:113
msgctxt "@info %1 is a timer's identifier"
msgid ""
"The timer %1 came round too late, perhaps after the computer slept through "
"its time, so its session wasn't started. Its next time is kept."
msgstr "定时器 %1 触发得太晚（可能是计算机在预定时间处于睡眠状态），因此未启动其会话。它的下一次时间保持不变。"

#: app/errormessages.cpp:117
msgctxt "@info %1 is a recording's file, with its folder"
msgid "The tags of the recording %1 couldn't be saved. The file is as it was."
msgstr "无法保存录音 %1 的标签。文件保持原样。"

#: app/errormessages.cpp:119
msgctxt "@info %1 is why"
msgid ""
"The stream's password wasn't saved: %1. It wasn't written anywhere else."
msgstr "未保存流的密码：%1。它也没有被写入其他任何地方。"

#: app/errormessages.cpp:122
msgctxt ""
"@info %1 is a radio station's name, or the block's when it has none; %2 is "
"why"
msgid ""
"The stream “%1” stopped trying to reach its server: %2. It tries again when "
"you change its settings or its password."
msgstr "流“%1”已停止尝试连接其服务器：%2。当您更改其设置或密码时，它会再次尝试。"

#: app/errormessages.cpp:126
msgctxt ""
"@info %1 is a recording's file, with its folder; %2 is a number of megabytes"
msgid ""
"Only %2 MB are left on the disk the recording %1 is on. It's still recording,"
" and it stops cleanly before the disk is full."
msgstr "录音 %1 所在的磁盘仅剩 %2 MB。录音仍在继续，并会在磁盘写满前正常停止。"

#: app/errormessages.cpp:143
msgctxt "@info a reason a session would not start"
msgid "it uses a block this version doesn't have"
msgstr "它使用了当前版本没有的模块"

#: app/errormessages.cpp:145
msgctxt "@info a reason a session would not start"
msgid "one of its blocks can't run at this sample rate"
msgstr "它的某个模块无法在此采样率下运行"

#: app/errormessages.cpp:148
msgctxt "@info a reason a session would not start"
msgid "its blocks and connections don't make a signal path that can run"
msgstr "它的模块和连接无法构成可运行的信号路径"

#: app/errormessages.cpp:149
msgctxt "@info a reason a session would not start"
msgid "the audio system wouldn't take it"
msgstr "音频系统不接受它"

#: app/errormessages.cpp:150
msgctxt "@info a reason something was refused"
msgid "the session isn't running"
msgstr "会话未在运行"

#: app/errormessages.cpp:151
msgctxt "@info a reason a recording was not renamed"
msgid "that isn't a name a file can have"
msgstr "这不是有效的文件名"

#: app/errormessages.cpp:152
msgctxt "@info a reason a recording was not renamed"
msgid "another file already has that name"
msgstr "已有其他文件使用该名称"

#: app/errormessages.cpp:153
msgctxt "@info a reason a recording was not renamed"
msgid "the disk refused"
msgstr "磁盘拒绝了操作"

#: app/errormessages.cpp:154
msgctxt "@info a reason a recording can't be played"
msgid "the file can't be read as sound"
msgstr "无法将该文件读取为音频"

#: app/errormessages.cpp:155
msgctxt "@info a reason a recording can't be played"
msgid "the audio system isn't running"
msgstr "音频系统未在运行"

#: app/errormessages.cpp:157
msgctxt "@info a reason a session would not start"
msgid "the audio system isn't running"
msgstr "音频系统未在运行"

#: app/errormessages.cpp:159
msgctxt "@info a reason the background engine couldn't be started"
msgid "there is no session bus"
msgstr "没有会话总线"

#: app/errormessages.cpp:161
msgctxt "@info a reason the background engine couldn't be started"
msgid "it isn't installed"
msgstr "它未安装"

#: app/errormessages.cpp:162
msgctxt "@info a reason the background engine couldn't be started"
msgid "it didn't start"
msgstr "它未能启动"

#: app/errormessages.cpp:163
msgctxt "@info a reason an edit was refused"
msgid "the block it names isn't in the session"
msgstr "它指定的模块不在会话中"

#: app/errormessages.cpp:165
msgctxt "@info a reason a plugin was not restarted"
msgid "it isn't a plugin that is switched on"
msgstr "它不是已开启的插件"

#: app/errormessages.cpp:166
msgctxt "@info a reason a plugin preset was refused"
msgid "it couldn't be written"
msgstr "无法写入它"

#: app/errormessages.cpp:168
msgctxt "@info a reason a plugin preset was refused"
msgid "the plugin's presets couldn't be listed"
msgstr "无法列出插件的预设"

#: app/errormessages.cpp:169
msgctxt "@info a reason an edit was refused"
msgid "another block already has that name"
msgstr "已有其他模块使用该名称"

#: app/errormessages.cpp:170
msgctxt "@info a reason an edit was refused"
msgid "a block can't be connected to itself"
msgstr "模块不能连接到自身"

#: app/errormessages.cpp:171
msgctxt "@info a reason an edit was refused"
msgid "that connection is already there"
msgstr "该连接已存在"

#: app/errormessages.cpp:172
msgctxt "@info a reason an edit was refused"
msgid "there's no such connection"
msgstr "不存在该连接"

#: app/errormessages.cpp:174
msgctxt "@info a reason an edit was refused"
msgid "that setting doesn't take a value of that kind"
msgstr "该设置项不接受这种类型的值"

#: app/errormessages.cpp:176
msgctxt "@info a reason an edit was refused"
msgid "that setting doesn't take that value"
msgstr "该设置项不接受这个值"

#: app/errormessages.cpp:178
msgctxt "@info a reason an edit was refused"
msgid "the timer is missing a time, a day or how long it runs"
msgstr "定时器缺少时间、日期或运行时长"

#: app/errormessages.cpp:179
msgctxt "@info a reason an edit was refused"
msgid "there's no such timer in the session"
msgstr "会话中没有这个定时器"

#: app/errormessages.cpp:181
msgctxt "@info a reason an edit was refused"
msgid "another session already has a timer with that identifier"
msgstr "另一个会话已有使用该标识符的定时器"

#: app/errormessages.cpp:183
msgctxt "@info a reason a preset was refused"
msgid "there's no preset of that name"
msgstr "没有该名称的预设"

#: app/errormessages.cpp:186
msgctxt "@info a reason a preset was refused"
msgid ""
"a preset's name is its file's, so it can't be empty or contain / \\ : * ? \" "
"< > |"
msgstr "预设的名称就是其文件名，因此不能为空，也不能包含 / \\ : * ? \" < > |"

#: app/errormessages.cpp:187
msgctxt "@info a reason a preset was refused"
msgid "a preset of that name is already there"
msgstr "已存在该名称的预设"

#: app/errormessages.cpp:189
msgctxt "@info a reason a preset was refused"
msgid "it's one of the presets that come with the application"
msgstr "它是应用程序自带的出厂预设"

#: app/errormessages.cpp:190
msgctxt "@info a reason a preset was refused"
msgid "its file couldn't be read"
msgstr "无法读取其文件"

#: app/errormessages.cpp:191
msgctxt "@info a reason a preset was refused"
msgid "its file couldn't be written"
msgstr "无法写入其文件"

#: app/errormessages.cpp:192
msgctxt "@info a reason a preset was refused"
msgid "its file isn't valid JSON"
msgstr "其文件不是有效的 JSON"

#: app/errormessages.cpp:193
msgctxt "@info a reason a preset was refused"
msgid "its file isn't a preset"
msgstr "其文件不是预设"

#: app/errormessages.cpp:194
msgctxt "@info a reason a preset was refused"
msgid "it's for another kind of block"
msgstr "它适用于另一类模块"

#: app/errormessages.cpp:197
msgctxt "@info a reason a virtual device was refused"
msgid "a device needs a name"
msgstr "设备需要名称"

#: app/errormessages.cpp:198
msgctxt "@info a reason a virtual device was refused"
msgid "the name is too long"
msgstr "名称太长"

#: app/errormessages.cpp:200
msgctxt "@info a reason a virtual device was refused"
msgid "a name can't contain line breaks or tabs"
msgstr "名称不能包含换行符或制表符"

#: app/errormessages.cpp:202
msgctxt "@info a reason a virtual device was refused"
msgid "a name can't start or end with a space"
msgstr "名称不能以空格开头或结尾"

#: app/errormessages.cpp:203 app/errormessages.cpp:223
msgctxt "@info a reason a virtual device was refused"
msgid "there's no such device"
msgstr "不存在该设备"

#: app/errormessages.cpp:205
msgctxt "@info a reason a virtual device was refused"
msgid "two devices would have the same identifier"
msgstr "两个设备将具有相同的标识符"

#: app/errormessages.cpp:208
msgctxt "@info a reason a virtual device was refused"
msgid ""
"a device for all users can't be kept with your own, or yours with theirs"
msgstr "所有用户的设备不能与您自己的设备保存在一起，反之亦然"

#: app/errormessages.cpp:210
msgctxt "@info a reason a virtual device was refused"
msgid "there are already as many devices as can be kept"
msgstr "设备数量已达上限"

#: app/errormessages.cpp:213
msgctxt "@info a reason a virtual device was refused"
msgid ""
"the file the devices are kept in wasn't written by Reverblabr, so it's left "
"alone"
msgstr "保存设备的文件不是由 Reverblabr 写入的，因此不会改动它"

#: app/errormessages.cpp:216
msgctxt "@info a reason a virtual device was refused"
msgid "the file the devices are kept in is damaged, so it's left alone"
msgstr "保存设备的文件已损坏，因此不会改动它"

#: app/errormessages.cpp:219
msgctxt "@info a reason a virtual device was refused"
msgid "the file the devices are kept in couldn't be read"
msgstr "无法读取保存设备的文件"

#: app/errormessages.cpp:222
msgctxt "@info a reason a virtual device was refused"
msgid "the file the devices are kept in couldn't be written"
msgstr "无法写入保存设备的文件"

#: app/errormessages.cpp:226
msgctxt "@info a reason a virtual device was refused"
msgid "it's a device for all users, which needs an administrator to change"
msgstr "这是所有用户的设备，需要管理员才能更改"

#: app/errormessages.cpp:229
msgctxt "@info a reason a virtual device was refused"
msgid "the request didn't say what kind of device to make"
msgstr "请求中没有说明要创建哪种设备"

#: app/errormessages.cpp:234
msgctxt "@info a reason a virtual device for all users was refused"
msgid ""
"the devices for all users were changed elsewhere in the meantime; the list "
"now shows them"
msgstr "所有用户的设备在此期间已在别处被更改；列表现在显示的是最新的设备"

#: app/errormessages.cpp:237
msgctxt "@info a reason a virtual device for all users was refused"
msgid "the administrator's password was cancelled"
msgstr "管理员密码输入已取消"

#: app/errormessages.cpp:240
msgctxt "@info a reason a virtual device for all users was refused"
msgid "the administrator's password wasn't accepted"
msgstr "管理员密码未被接受"

#: app/errormessages.cpp:243
msgctxt "@info a reason a virtual device for all users was refused"
msgid ""
"the part of Reverblabr that changes devices for all users isn't installed"
msgstr "Reverblabr 中负责更改所有用户设备的组件未安装"

#: app/errormessages.cpp:246
msgctxt "@info a reason a virtual device for all users was refused"
msgid "the part of Reverblabr that changes devices for all users failed"
msgstr "Reverblabr 中负责更改所有用户设备的组件出错"

#: app/errormessages.cpp:249
msgctxt "@info a reason a virtual device for all users was refused"
msgid ""
"another change for all users is still waiting for the administrator's "
"password"
msgstr "另一项针对所有用户的更改仍在等待管理员密码"

#: app/errormessages.cpp:251
msgctxt "@info a reason a recording stopped"
msgid "its folder couldn't be made"
msgstr "无法创建其文件夹"

#: app/errormessages.cpp:252
msgctxt "@info a reason a recording stopped"
msgid "a file of that name is already there"
msgstr "已存在同名文件"

#: app/errormessages.cpp:254
msgctxt "@info a reason a recording stopped"
msgid "the file couldn't be made there; check the folder"
msgstr "无法在该位置创建文件；请检查文件夹"

#: app/errormessages.cpp:257
msgctxt "@info a reason a recording stopped"
msgid "that format can't be written at this sample rate or with these channels"
msgstr "该格式无法以此采样率或这些声道写入"

#: app/errormessages.cpp:260
msgctxt "@info a reason a recording stopped"
msgid ""
"the disk is full, or so nearly full that the file was finished while it still"
" could be"
msgstr "磁盘已满，或几乎已满，因此趁还能写入时结束了文件"

#: app/errormessages.cpp:261
msgctxt "@info a reason a recording stopped"
msgid "writing to the disk failed"
msgstr "写入磁盘失败"

#: app/errormessages.cpp:267
msgctxt "@info a reason a recording stopped"
msgid ""
"this system's FFmpeg has no encoder for that format. Install the full FFmpeg "
"(on Fedora, from RPM Fusion), or record to Opus or FLAC instead"
msgstr ""
"此系统的 FFmpeg 没有该格式的编码器。请安装完整版 FFmpeg（在 Fedora 上可从 RPM Fusion 获取），或改为录制 Opus 或 "
"FLAC"

#: app/errormessages.cpp:271
msgctxt "@info why a recording format is not offered"
msgid ""
"this system's FFmpeg has no encoder for it. Install the full FFmpeg (on "
"Fedora, from RPM Fusion), or record to Opus or FLAC instead"
msgstr ""
"此系统的 FFmpeg 没有它的编码器。请安装完整版 FFmpeg（在 Fedora 上可从 RPM Fusion 获取），或改为录制 Opus 或 "
"FLAC"

#: app/errormessages.cpp:276
msgctxt "@info a reason a password was not saved"
msgid "there is no password store, such as KWallet, to keep it in"
msgstr "没有可用于保存它的密码库（例如 KWallet）"

#: app/errormessages.cpp:278
msgctxt "@info a reason a password was not saved"
msgid "the password store didn't open, or was told not to"
msgstr "密码库没有打开，或被要求不要打开"

#: app/errormessages.cpp:279
msgctxt "@info a reason a password was not saved"
msgid "the password store refused it"
msgstr "密码库拒绝了它"

#: app/errormessages.cpp:281
msgctxt "@info a reason a password was not saved"
msgid "that block isn't a Broadcast or Live Stream block"
msgstr "该模块不是广播或直播模块"

#: app/errormessages.cpp:282
msgctxt "@info a reason a stream stopped"
msgid "the server refused the user name or password"
msgstr "服务器拒绝了用户名或密码"

#: app/errormessages.cpp:283
msgctxt "@info a reason a stream stopped"
msgid "no password or stream key is set"
msgstr "未设置密码或推流密钥"

#: app/errormessages.cpp:284
msgctxt "@info a reason a stream stopped"
msgid "no server is set"
msgstr "未设置服务器"

#: app/errormessages.cpp:288
msgctxt "@info a reason a stream stopped"
msgid "the server's certificate isn't from an authority this computer trusts"
msgstr "服务器的证书不是由此计算机信任的颁发机构签发的"

#: app/errormessages.cpp:291
msgctxt "@info a reason a stream stopped"
msgid ""
"the server's certificate has expired, or isn't valid yet (check this "
"computer's clock)"
msgstr "服务器的证书已过期或尚未生效（请检查此计算机的时钟）"

#: app/errormessages.cpp:293
msgctxt "@info a reason a stream stopped"
msgid "the server's certificate is for another name than its host"
msgstr "服务器证书对应的名称与其主机名不符"

#: app/errormessages.cpp:294
msgctxt "@info a reason a stream stopped"
msgid "the server's certificate was refused"
msgstr "服务器的证书被拒绝"

#: app/errormessages.cpp:297
msgctxt "@info a reason a stream stopped"
msgid ""
"the server offers no secure connection this computer accepts (TLS 1.2 or "
"later)"
msgstr "服务器未提供此计算机可接受的安全连接（TLS 1.2 或更高版本）"

#: app/errormessages.cpp:300
msgctxt "@info a reason a stream stopped"
msgid ""
