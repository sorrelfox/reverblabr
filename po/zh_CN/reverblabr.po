#: blocks/recorder/ui/RecorderWords.qml:170
msgctxt "@info a recording quality"
msgid "MP3, 192 kbps variable: good for most listening."
msgstr "MP3，192 kbps 可变比特率：适合大多数聆听场合。"

#: blocks/recorder/ui/RecorderWords.qml:173
msgctxt "@info a recording quality"
msgid ""
"MP3, 256 kbps variable: as good as MP3 gets for most ears, and plays "
"anywhere."
msgstr "MP3，256 kbps 可变比特率：对大多数人的耳朵来说已是 MP3 的最佳音质，并且随处都能播放。"

#: blocks/recorder/ui/RecorderWords.qml:175
msgctxt "@info a recording quality"
msgid "AAC in M4A, 256 kbps: smaller than MP3 for the same sound."
msgstr "M4A 封装的 AAC，256 kbps：音质相同时比 MP3 更小。"

#: blocks/recorder/ui/RecorderWords.qml:177
msgctxt "@info a recording quality"
msgid "FLAC, 24-bit: every sample kept, at about half the size."
msgstr "FLAC，24 位：保留每个采样，大小约为一半。"

#: blocks/recorder/ui/RecorderWords.qml:179
msgctxt "@info a recording quality"
msgid "WAV, 24-bit: every sample kept, for editing afterwards."
msgstr "WAV，24 位：保留每个采样，适合后期编辑。"

#: blocks/recorder/ui/RecorderWords.qml:181
msgctxt "@info a recording quality set by hand"
msgid "Set by hand, below."
msgstr "在下方手动设置。"

