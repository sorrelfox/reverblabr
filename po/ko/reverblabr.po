msgstr "%1 dB 올리는 중"

#: blocks/nightlevel/ui/NightLevelWords.qml:172
msgctxt "@info:status Night Level, 'Peaks held, down 12 dB'"
msgid "Peaks held, down %1 dB"
msgstr "피크 억제 중, %1 dB 내림"

#: blocks/nightlevel/ui/NightLevelWords.qml:174
msgctxt "@info:status a Night Level that is switched off"
msgid "Switched off"
msgstr "꺼짐"

#: blocks/nightlevel/ui/NightLevelWords.qml:176
msgctxt "@info:status Night Level while its session is stopped"
msgid "Not playing"
msgstr "재생 중 아님"

#: blocks/nightlevel/ui/NightLevelWords.qml:185
msgctxt "@info Night Level's found level, held with no voice, '-27 LUFS held'"
msgid "%1 held"
msgstr "%1 고정됨"

#: blocks/nightlevel/ui/NightLevelWords.qml:187
msgctxt "@info Night Level's found level, 'Speech -27 LUFS'"
msgid "Speech %1"
msgstr "말소리 %1"

#: blocks/nightlevel/ui/NightLevelWords.qml:189
msgctxt "@info Night Level's typed level, 'Typed -24 LUFS'"
msgid "Typed %1"
