#: blocks/nightlevel/ui/NightLevelWords.qml:166
msgctxt "@info:status Night Level"
msgid "Left alone"
msgstr "그대로 둠"

#: blocks/nightlevel/ui/NightLevelWords.qml:168
msgctxt "@info:status Night Level, 'Turning down 7 dB'"
