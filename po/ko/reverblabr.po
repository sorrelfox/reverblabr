msgstr "방송 중"

#: blocks/broadcast/ui/BroadcastWords.qml:99
msgctxt "@info:status a stream"
msgid "Connecting…"
msgstr "연결 중…"

#: blocks/broadcast/ui/BroadcastWords.qml:101
msgctxt "@info:status a stream"
msgid "Getting the password…"
msgstr "암호를 가져오는 중…"

#: blocks/broadcast/ui/BroadcastWords.qml:104
msgctxt "@info:status a stream; %2 says why"
msgid "%2. Trying again in %1 second…"
