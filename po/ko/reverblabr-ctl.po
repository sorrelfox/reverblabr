#: ctl/commands.cpp:137
msgctxt "@info a timer that is switched off"
msgid "off"
msgstr "꺼짐"

#: ctl/commands.cpp:139
msgctxt "@info a timer running its session, and until when"
msgid "running until %1"
msgstr "%1까지 실행 중"

#: ctl/commands.cpp:143
