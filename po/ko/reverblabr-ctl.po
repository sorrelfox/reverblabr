msgid "%1 s"
msgstr "%1초"

#: ctl/commands.cpp:97
msgctxt "@info a timer's duration in minutes"
msgid "%1 min"
msgstr "%1분"

#: ctl/commands.cpp:100
msgctxt "@info a timer's duration in hours"
msgid "%1 h"
msgstr "%1시간"

#: ctl/commands.cpp:102
msgctxt "@info a timer's duration in hours and minutes"
msgid "%1 h %2 min"
msgstr "%1시간 %2분"

#: ctl/commands.cpp:110
msgctxt "@info a timer that runs once, on a date"
msgid "once on %1"
msgstr "%1에 한 번"

#: ctl/commands.cpp:113
