msgstr "Non c'è un bus di sessione su cui raggiungere il motore."

#: ctl/commands.cpp:539
msgctxt "@info"
msgid "The engine is not running."
msgstr "Il motore non è in esecuzione."

#: ctl/commands.cpp:542
msgctxt "@info"
msgid "The engine would not start (%1)."
msgstr "Il motore non si è avviato (%1)."

#: ctl/commands.cpp:544
msgctxt "@info"
msgid "The engine is not installed, so the session bus cannot start it."
msgstr ""
"Il motore non è installato, quindi il bus di sessione non può avviarlo."

#: ctl/commands.cpp:547
msgctxt "@info"
msgid "The engine did not answer %1 in time."
msgstr "Il motore non ha risposto a %1 in tempo."

#: ctl/commands.cpp:553
msgctxt "@info"
msgid "The engine did not take the call: %1"
msgstr "Il motore non ha accettato la chiamata: %1"

#: ctl/commands.cpp:556
msgctxt "@info"
msgid "“%1” could not start (%2)."
msgstr "Impossibile avviare «%1» (%2)."

#: ctl/commands.cpp:560
msgctxt "@info"
msgid "The engine refused the change (%1)."
msgstr "Il motore ha rifiutato la modifica (%1)."

#: ctl/commands.cpp:563
msgctxt "@info"
msgid "There is no timer “%1”."
msgstr "Non esiste il timer «%1»."

#: ctl/commands.cpp:567
msgctxt "@info"
msgid ""
"The timer %1 came round more than two minutes after its time, perhaps after "
"the computer slept, so its session was not started."
msgstr ""
"Il timer %1 è scattato più di due minuti dopo l'ora prevista, forse dopo una "
"sospensione del computer, quindi la sua sessione non è stata avviata."

#: ctl/commands.cpp:572
msgctxt "@info"
msgid "The recording could not be split (%1)."
msgstr "Impossibile dividere la registrazione (%1)."

#: ctl/commands.cpp:576
msgctxt "@info engine error code and its details"
msgid "The engine refused: %1 %2"
msgstr "Il motore ha rifiutato: %1 %2"

#: ctl/main.cpp:56
msgctxt "@info:usage"
msgid ""
"Usage: reverblabr-ctl [--json] [--timeout SECONDS] [--no-activate] COMMAND\n"
"\n"
"Commands:\n"
"  list                              the sessions' names, one a line\n"
"  status [SESSION]                  every session's state, or one's\n"
"  start SESSION                     run a session\n"
"  stop SESSION                      stop a session\n"
"  split SESSION [RECORDER]          start a new file in a running session's Recorders\n"
"  switch SESSION [SWITCH] A|B       turn an Input Switch to A or B\n"
"  set SESSION BLOCK SETTING VALUE   change one setting of a block\n"
"  timers list [SESSION]             every session's timers, or one's\n"
"  timer-fire [--scheduled] TIMER    do now what a timer does when its time comes\n"
"\n"
"A session is named by its name or its id, a block by its name or its id.\n"
"  --json            print the answer as JSON, the same in every language\n"
"  --timeout SECONDS how long to wait for the engine (10)\n"
"  --no-activate     only ask an engine that is already running\n"
msgstr ""
"Uso: reverblabr-ctl [--json] [--timeout SECONDI] [--no-activate] COMANDO\n"
"\n"
"Comandi:\n"
"  list                                      i nomi delle sessioni, uno per riga\n"
"  status [SESSIONE]                         lo stato di ogni sessione, o di una sola\n"
"  start SESSIONE                            avvia una sessione\n"
"  stop SESSIONE                             ferma una sessione\n"
"  split SESSIONE [REGISTRATORE]             inizia un nuovo file nei Registratori di una sessione in esecuzione\n"
"  switch SESSIONE [SELETTORE] A|B           porta un Selettore ingresso su A o B\n"
"  set SESSIONE BLOCCO IMPOSTAZIONE VALORE   cambia un'impostazione di un blocco\n"
"  timers list [SESSIONE]                    i timer di ogni sessione, o di una sola\n"
"  timer-fire [--scheduled] TIMER            esegui ora ciò che fa un timer quando arriva il suo momento\n"
"\n"
"Una sessione si indica con il suo nome o il suo ID, un blocco con il suo nome o il suo ID.\n"
"  --json            stampa la risposta in JSON, uguale in ogni lingua\n"
"  --timeout SECONDI quanto attendere il motore (10)\n"
"  --no-activate     interroga solo un motore già in esecuzione\n"

