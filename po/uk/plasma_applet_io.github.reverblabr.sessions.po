#: plasmoid/package/contents/ui/CompactRepresentation.qml:38
#: plasmoid/package/contents/ui/main.qml:38
msgctxt "@title the panel widget's name"
msgid "Reverblabr Sessions"
msgstr "Сеанси Reverblabr"

#: plasmoid/package/contents/ui/FullRepresentation.qml:41
msgctxt "@title the sessions listed in the panel widget"
msgid "Sessions"
msgstr "Сеанси"

#: plasmoid/package/contents/ui/FullRepresentation.qml:62
msgctxt "@info %1 is a session"
msgid "\"%1\" is no longer saved."
msgstr "Сеансу «%1» більше немає серед збережених."

#: plasmoid/package/contents/ui/FullRepresentation.qml:63
msgctxt "@info %1 is a session"
msgid "\"%1\" could not be started. Open Reverblabr to see why."
msgstr ""
"Не вдалося запустити «%1». Відкрийте Reverblabr, щоб дізнатися причину."

#: plasmoid/package/contents/ui/FullRepresentation.qml:98
msgctxt "@info in the panel widget"
msgid "No saved sessions yet"
msgstr "Збережених сеансів ще немає"

#: plasmoid/package/contents/ui/FullRepresentation.qml:99
msgctxt "@info in the panel widget"
msgid "Reverblabr's background engine is not installed"
msgstr "Фоновий рушій Reverblabr не встановлено"

#: plasmoid/package/contents/ui/LevelBar.qml:43
msgctxt "@info:whatsthis the loudest channel, in decibels"
msgid "%1 dB"
msgstr "%1 dB"

#: plasmoid/package/contents/ui/LevelBar.qml:44
msgctxt "@info:whatsthis nothing is running"
msgid "Idle"
msgstr "Бездіяльність"

#: plasmoid/package/contents/ui/SessionRow.qml:67
msgctxt "@info:status a session is writing a recording"
msgid "Recording"
msgstr "Запис"

#: plasmoid/package/contents/ui/SessionRow.qml:75
msgctxt "@info:tooltip %1 is a session"
msgid "Level of %1"
msgstr "Рівень сеансу %1"

#: plasmoid/package/contents/ui/SessionRow.qml:84
msgctxt "@action:button stop the session"
msgid "Stop"
msgstr "Зупинити"

#: plasmoid/package/contents/ui/SessionRow.qml:85
msgctxt "@action:button start the session"
msgid "Run"
msgstr "Запустити"

#: plasmoid/package/contents/ui/SessionRow.qml:89
msgctxt "@action:button %1 is a session"
msgid "Stop %1"
msgstr "Зупинити %1"

#: plasmoid/package/contents/ui/SessionRow.qml:90
msgctxt "@action:button %1 is a session"
msgid "Run %1"
msgstr "Запустити %1"

#: plasmoid/package/contents/ui/status.js:19
msgctxt "@info:status"
msgid "Reverblabr's background engine is not installed"
msgstr "Фоновий рушій Reverblabr не встановлено"

#: plasmoid/package/contents/ui/status.js:22
msgctxt "@info:status"
msgid "No session is running"
msgstr "Жоден сеанс не працює"

#: plasmoid/package/contents/ui/status.js:25
msgctxt "@info:status"
msgid "%1 session running, recording"
msgid_plural "%1 sessions running, recording"
msgstr[0] "Працює %1 сеанс, іде запис"
msgstr[1] "Працюють %1 сеанси, іде запис"
msgstr[2] "Працює %1 сеансів, іде запис"

#: plasmoid/package/contents/ui/status.js:28
msgctxt "@info:status"
msgid "%1 session running"
msgid_plural "%1 sessions running"
msgstr[0] "Працює %1 сеанс"
msgstr[1] "Працюють %1 сеанси"
msgstr[2] "Працює %1 сеансів"
