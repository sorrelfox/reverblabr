msgstr[0] "%2. Пробуємо знову через %1 секунду…"
msgstr[1] "%2. Пробуємо знову через %1 секунди…"
msgstr[2] "%2. Пробуємо знову через %1 секунд…"

#: blocks/broadcast/ui/BroadcastWords.qml:110
msgctxt "@info:status a stream"
