msgctxt "@action a global shortcut"
msgid "Show Reverblabr"
msgstr "Mostrar o Reverblabr"

#: app/globalshortcuts.cpp:119
msgctxt "@action a global shortcut"
msgid "Input Switch: play A"
msgstr "Seletor de entrada: tocar A"

