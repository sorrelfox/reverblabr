#: ctl/commands.cpp:536
msgctxt "@info"
msgid "There is no session bus to reach the engine on."
msgstr "Não há barramento de sessão para alcançar o mecanismo."

#: ctl/commands.cpp:539
msgctxt "@info"
msgid "The engine is not running."
msgstr "O mecanismo não está em execução."

#: ctl/commands.cpp:542
msgctxt "@info"
msgid "The engine would not start (%1)."
msgstr "O mecanismo não iniciou (%1)."

#: ctl/commands.cpp:544
msgctxt "@info"
msgid "The engine is not installed, so the session bus cannot start it."
msgstr ""
"O mecanismo não está instalado, então o barramento de sessão não pode iniciá-"
"lo."

#: ctl/commands.cpp:547
msgctxt "@info"
msgid "The engine did not answer %1 in time."
msgstr "O mecanismo não respondeu a %1 a tempo."

#: ctl/commands.cpp:553
msgctxt "@info"
msgid "The engine did not take the call: %1"
msgstr "O mecanismo não aceitou a chamada: %1"

#: ctl/commands.cpp:556
msgctxt "@info"
msgid "“%1” could not start (%2)."
msgstr "“%1” não pôde ser iniciada (%2)."

#: ctl/commands.cpp:560
msgctxt "@info"
msgid "The engine refused the change (%1)."
msgstr "O mecanismo recusou a alteração (%1)."

#: ctl/commands.cpp:563
msgctxt "@info"
msgid "There is no timer “%1”."
msgstr "Não há nenhum temporizador “%1”."

#: ctl/commands.cpp:567
msgctxt "@info"
msgid ""
"The timer %1 came round more than two minutes after its time, perhaps after "
"the computer slept, so its session was not started."
msgstr ""
"O temporizador %1 disparou mais de dois minutos depois do horário, talvez "
"depois de o computador entrar em suspensão, por isso a sessão dele não foi "
"iniciada."

#: ctl/commands.cpp:572
msgctxt "@info"
msgid "The recording could not be split (%1)."
msgstr "Não foi possível dividir a gravação (%1)."

#: ctl/commands.cpp:576
msgctxt "@info engine error code and its details"
msgid "The engine refused: %1 %2"
msgstr "O mecanismo recusou: %1 %2"

#: ctl/main.cpp:56
msgctxt "@info:usage"
msgid ""
"Usage: reverblabr-ctl [--json] [--timeout SECONDS] [--no-activate] COMMAND\n"
"\n"
"Commands:\n"
"  list                              the sessions' names, one a line\n"
"  status [SESSION]                  every session's state, or one's\n"
"  start SESSION                     run a session\n"
"  stop SESSION                      stop a session\n"
"  split SESSION [RECORDER]          start a new file in a running session's Recorders\n"
"  switch SESSION [SWITCH] A|B       turn an Input Switch to A or B\n"
"  set SESSION BLOCK SETTING VALUE   change one setting of a block\n"
"  timers list [SESSION]             every session's timers, or one's\n"
"  timer-fire [--scheduled] TIMER    do now what a timer does when its time comes\n"
"\n"
"A session is named by its name or its id, a block by its name or its id.\n"
"  --json            print the answer as JSON, the same in every language\n"
"  --timeout SECONDS how long to wait for the engine (10)\n"
"  --no-activate     only ask an engine that is already running\n"
msgstr ""
"Uso: reverblabr-ctl [--json] [--timeout SEGUNDOS] [--no-activate] COMANDO\n"
"\n"
"Comandos:\n"
"  list                                   os nomes das sessões, um por linha\n"
"  status [SESSÃO]                        o estado de cada sessão, ou de uma só\n"
"  start SESSÃO                           executar uma sessão\n"
"  stop SESSÃO                            parar uma sessão\n"
"  split SESSÃO [GRAVADOR]                começar um novo arquivo nos Gravadores de uma sessão em execução\n"
"  switch SESSÃO [SELETOR] A|B            mudar um Seletor de entrada para A ou B\n"
"  set SESSÃO BLOCO CONFIGURAÇÃO VALOR    alterar uma configuração de um bloco\n"
"  timers list [SESSÃO]                   os temporizadores de cada sessão, ou de uma só\n"
"  timer-fire [--scheduled] TEMPORIZADOR  fazer agora o que um temporizador faz quando chega a hora dele\n"
"\n"
"Uma sessão é indicada pelo nome ou pelo ID; um bloco, pelo nome ou pelo ID.\n"
"  --json             mostrar a resposta em JSON, igual em todos os idiomas\n"
"  --timeout SEGUNDOS quanto tempo esperar pelo mecanismo (10)\n"
"  --no-activate      perguntar só a um mecanismo que já está em execução\n"

