msgstr "Er is geen sessiebus waarop de engine te bereiken is."

#: ctl/commands.cpp:539
msgctxt "@info"
msgid "The engine is not running."
msgstr "De engine is niet actief."

#: ctl/commands.cpp:542
msgctxt "@info"
msgid "The engine would not start (%1)."
msgstr "De engine wilde niet starten (%1)."

#: ctl/commands.cpp:544
msgctxt "@info"
msgid "The engine is not installed, so the session bus cannot start it."
msgstr ""
"De engine is niet geïnstalleerd, dus de sessiebus kan die niet starten."

#: ctl/commands.cpp:547
msgctxt "@info"
msgid "The engine did not answer %1 in time."
msgstr "De engine heeft %1 niet op tijd beantwoord."

#: ctl/commands.cpp:553
msgctxt "@info"
msgid "The engine did not take the call: %1"
msgstr "De engine heeft de aanroep niet aangenomen: %1"

#: ctl/commands.cpp:556
msgctxt "@info"
msgid "“%1” could not start (%2)."
msgstr "‘%1’ kon niet starten (%2)."

#: ctl/commands.cpp:560
msgctxt "@info"
msgid "The engine refused the change (%1)."
msgstr "De engine weigerde de wijziging (%1)."

#: ctl/commands.cpp:563
msgctxt "@info"
msgid "There is no timer “%1”."
msgstr "Er is geen timer ‘%1’."

#: ctl/commands.cpp:567
msgctxt "@info"
msgid ""
"The timer %1 came round more than two minutes after its time, perhaps after "
"the computer slept, so its session was not started."
msgstr ""
"De timer %1 kwam meer dan twee minuten na zijn tijdstip aan de beurt, "
"misschien omdat de computer sliep, dus de sessie is niet gestart."

#: ctl/commands.cpp:572
msgctxt "@info"
msgid "The recording could not be split (%1)."
msgstr "De opname kon niet worden gesplitst (%1)."

#: ctl/commands.cpp:576
msgctxt "@info engine error code and its details"
msgid "The engine refused: %1 %2"
msgstr "De engine weigerde: %1 %2"

#: ctl/main.cpp:56
msgctxt "@info:usage"
msgid ""
"Usage: reverblabr-ctl [--json] [--timeout SECONDS] [--no-activate] COMMAND\n"
"\n"
"Commands:\n"
"  list                              the sessions' names, one a line\n"
"  status [SESSION]                  every session's state, or one's\n"
"  start SESSION                     run a session\n"
"  stop SESSION                      stop a session\n"
"  split SESSION [RECORDER]          start a new file in a running session's Recorders\n"
"  switch SESSION [SWITCH] A|B       turn an Input Switch to A or B\n"
"  set SESSION BLOCK SETTING VALUE   change one setting of a block\n"
"  timers list [SESSION]             every session's timers, or one's\n"
"  timer-fire [--scheduled] TIMER    do now what a timer does when its time comes\n"
"\n"
"A session is named by its name or its id, a block by its name or its id.\n"
"  --json            print the answer as JSON, the same in every language\n"
"  --timeout SECONDS how long to wait for the engine (10)\n"
"  --no-activate     only ask an engine that is already running\n"
msgstr ""
"Gebruik: reverblabr-ctl [--json] [--timeout SECONDEN] [--no-activate] OPDRACHT\n"
"\n"
"Opdrachten:\n"
"  list                                de namen van de sessies, één per regel\n"
"  status [SESSIE]                     de status van elke sessie, of van één\n"
"  start SESSIE                        een sessie starten\n"
"  stop SESSIE                         een sessie stoppen\n"
"  split SESSIE [RECORDER]             een nieuw bestand beginnen in de Recorders van een actieve sessie\n"
"  switch SESSIE [SCHAKELAAR] A|B      een Ingangsschakelaar op A of B zetten\n"
"  set SESSIE BLOK INSTELLING WAARDE   één instelling van een blok wijzigen\n"
"  timers list [SESSIE]                de timers van elke sessie, of van één\n"
"  timer-fire [--scheduled] TIMER      nu doen wat een timer doet als zijn tijd komt\n"
"\n"
"Een sessie wordt opgegeven met haar naam of ID, een blok met zijn naam of ID.\n"
"  --json             het antwoord als JSON tonen, in elke taal hetzelfde\n"
"  --timeout SECONDEN hoe lang op de engine wordt gewacht (10)\n"
"  --no-activate      alleen een engine vragen die al actief is\n"

