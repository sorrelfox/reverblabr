msgstr "%1 kann nicht „%2“ sein. Möglich ist eine Zahl von %3 bis %4."

#: ctl/commands.cpp:525
msgctxt "@info"
msgid "%1 cannot be “%2”."
msgstr "%1 kann nicht „%2“ sein."

#: ctl/commands.cpp:528
