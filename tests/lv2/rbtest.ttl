@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<urn:reverblabr:test:gain>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "Reverblabr test gain" ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <urn:reverblabr:test:gain#window> ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_l" ;
        lv2:name "In left"
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "in_r" ;
        lv2:name "In right"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_l" ;
        lv2:name "Out left"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "out_r" ;
        lv2:name "Out right"
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 5 ;
        lv2:symbol "control" ;
        lv2:name "Control"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 6 ;
        lv2:symbol "notify" ;
        lv2:name "Notify"
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] .

# **The same settings, twice as loud**, and no window: a second plugin whose
# settings share their ids with the first's.
<urn:reverblabr:test:double>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "Reverblabr test gain, doubled" ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_l" ;
        lv2:name "In left"
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "in_r" ;
        lv2:name "In right"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_l" ;
        lv2:name "Out left"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "out_r" ;
        lv2:name "Out right"
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 5 ;
        lv2:symbol "control" ;
        lv2:name "Control"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 6 ;
        lv2:symbol "notify" ;
        lv2:name "Notify"
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] .

# **Shows itself, needs no display**: an X11 UI by type, which hosts that
# give it a parent could show, but it never opens one; this host takes its
# show interface first.
<urn:reverblabr:test:gain#window>
    a ui:X11UI ;
    lv2:requiredFeature urid:map ;
    lv2:extensionData ui:showInterface, ui:idleInterface .
