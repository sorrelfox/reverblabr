#
# A system TLS policy that still allows TLS 1.0 and 1.1, for the test that
# shows the stream's client refuses them by itself (GNUTLS_SYSTEM_PRIORITY_FILE).
[priorities]
SYSTEM = NORMAL:+VERS-TLS1.1:+VERS-TLS1.0:+SHA1:+SIGN-ALL
