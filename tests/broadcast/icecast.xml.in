<!--
SPDX-FileCopyrightText: 2026 Reverblabr contributors
SPDX-License-Identifier: MPL-2.0

The broadcast test's Icecast: on the loopback only, a source password the
test chose, an Icecast port, and a SHOUTcast port pair. The test fills in
the @…@ values.
-->
<icecast>
    <location>Test</location>
    <admin>test@localhost</admin>
    <hostname>127.0.0.1</hostname>
    <limits>
        <clients>20</clients>
        <sources>10</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>
    <authentication>
        <source-password>@PASSWORD@</source-password>
        <relay-password>@PASSWORD@</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>@PASSWORD@</admin-password>
    </authentication>
    <shoutcast-mount>/shout</shoutcast-mount>
    <listen-socket>
        <port>@PORT@</port>
        <bind-address>127.0.0.1</bind-address>
    </listen-socket>
    <listen-socket>
        <port>@SHOUTCAST_PORT@</port>
        <bind-address>127.0.0.1</bind-address>
        <shoutcast-mount>/shout</shoutcast-mount>
    </listen-socket>
    <fileserve>1</fileserve>
    <paths>
        <basedir>/usr/share/icecast</basedir>
        <logdir>/tmp</logdir>
        <webroot>/usr/share/icecast/web</webroot>
        <adminroot>/usr/share/icecast/admin</adminroot>
    </paths>
    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
    </logging>
    <security>
        <chroot>0</chroot>
    </security>
</icecast>
