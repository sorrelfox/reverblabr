# zsh completion for reverblabr-ctl: the commands and options, and the
# sessions' names. Names are asked of an engine that is already running
# (--no-activate): pressing Tab never starts the engine.

_reverblabr_ctl_sessions() {
  local -a names
  names=("${(@f)$(reverblabr-ctl --no-activate --timeout 2 list 2>/dev/null)}")
  names=(${names:#})
  (( ${#names} )) && compadd -a names
}

_reverblabr_ctl_timers() {
  local -a ids
  ids=("${(@f)$(reverblabr-ctl --no-activate --timeout 2 timers list 2>/dev/null |
    sed -n 's/.*(\([A-Za-z0-9_-]*\))$/\1/p')}")
  ids=(${ids:#})
  (( ${#ids} )) && compadd -a ids
}

_reverblabr-ctl() {
  local -a commands
  commands=(
    'list:the sessions'"'"' names'
    'status:every session'"'"'s state, or one'"'"'s'
    'start:run a session'
    'stop:stop a session'
    'split:start a new file in a running session'"'"'s Recorders'
    'switch:turn an Input Switch to A or B'
    'set:change one setting of a block'
    'timers:every session'"'"'s timers'
    'timer-fire:do now what a timer does when its time comes'
  )
  _arguments -C \
    '--json[print the answer as JSON]' \
    '--timeout[how long to wait for the engine]:seconds' \
    '--no-activate[only ask an engine that is already running]' \
    '(- *)'{-h,--help}'[print the commands]' \
    '(- *)--version[print the version]' \
    '1:command:->command' \
    '*::argument:->argument'
  case $state in
    command)
      _describe -t commands 'command' commands
      ;;
    argument)
      case $words[1] in
        status|start|stop|split|switch|set)
          if (( CURRENT == 2 )); then
            _reverblabr_ctl_sessions
          elif [[ $words[1] == switch ]]; then
            compadd A B
          fi
          ;;
        timers)
          if (( CURRENT == 2 )); then
            compadd list
          elif (( CURRENT == 3 )); then
            _reverblabr_ctl_sessions
          fi
          ;;
        timer-fire)
          (( CURRENT == 2 )) && _reverblabr_ctl_timers
          ;;
      esac
      ;;
  esac
}

_reverblabr-ctl "$@"
